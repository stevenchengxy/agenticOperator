# Inngest — local Docker dev server at ~/inngest-standalone/
#   - inngest.send() sends events here
#   - the serve handler at /api/inngest is registered against this server
#
# Reachable on the host as both http://localhost:8288 and
# http://172.16.1.83:8288 (LAN IP, for anyone on the same subnet).
INNGEST_DEV=http://localhost:8288
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=dev
INNGEST_SIGNING_KEY=dev

# From inside the Inngest container, "localhost" resolves to the
# container itself, not the host. Tell the SDK to advertise the
# host-from-container alias so dispatch lands on AO.
INNGEST_SERVE_HOST=http://host.docker.internal:3002
INNGEST_SERVE_PATH=/api/inngest

# ─── RAAS Inngest bridges ─────────────────────────────────────────────
# Partner Inngest at 10.100.0.70:8288. AO must talk to it for the full
# loop (RAAS sends RESUME_DOWNLOADED, AO sends MATCH_* back).
#
#   RAAS_BRIDGE_ENABLED=1    inbound bridge — pull events FROM RAAS to AO
#                            (server/inngest/raas-bridge.ts polls /v1/events)
#   RAAS_FORWARD_ENABLED=1   outbound forward — POST AO's MATCH_* events
#                            TO RAAS (server/ws/agents/match-resume.ts)
RAAS_INNGEST_URL=http://10.100.0.70:8288
# RAAS_INNGEST_URL=http://localhost:8288   # ← local raas_v4 (fallback)
RAAS_BRIDGE_ENABLED=0
RAAS_BRIDGE_EVENTS=RESUME_DOWNLOADED
RAAS_BRIDGE_POLL_INTERVAL_MS=5000
RAAS_FORWARD_ENABLED=1

# ─── RAAS Dashboard Internal API (HTTP, not Inngest) ──────────────────
# Used by matchResume to fetch the authoritative structured requirement
# (must_have_skills[], nice_to_have_skills[], degree_requirement,
# work_years, language_requirements, etc.) before calling RoboHire's
# /match-resume endpoint. This is more reliable than relying on
# REQUIREMENT_LOGGED.payload alone — RAAS may have added fields after
# the original event was published.
#
# Both sides must use the same shared secret (AGENT_API_KEY on RAAS,
# RAAS_AGENT_API_KEY here). 401 → keys don't match.
RAAS_INTERNAL_API_URL=http://192.168.1.105:3001
# RAAS_INTERNAL_API_URL=http://localhost:3001   # ← local raas_v4 (fallback)
RAAS_AGENT_API_KEY=internal-agentic-agent
RAAS_INTERNAL_API_TIMEOUT_MS=30000

# Fallback employee_id for matchResume → RAAS API calls.
