# Copy to .env.deploy, replace every placeholder, then run `npm run deploy:up`.
# This file is intentionally not used by local `npm run dev`.

# Compose project name — prefixes every container/volume. If the target
# machine already runs an OLDER AO under the default name "agentic-operator",
# pick a different name (e.g. ao-v2) so compose never treats the old
# containers as orphans of this project.
COMPOSE_PROJECT_NAME=agentic-operator

# Public/browser-facing addresses. Use this machine's LAN hostname/IP when
# operators or the RAAS partner access it from another machine.
AO_PUBLIC_ORIGIN=http://192.0.2.10:3002
INNGEST_PUBLIC_ORIGIN=http://192.0.2.10:8288
AO_BIND_ADDRESS=0.0.0.0
INNGEST_BIND_ADDRESS=0.0.0.0
POSTGRES_BIND_ADDRESS=127.0.0.1
AO_PORT=3002
INNGEST_PORT=8288
INNGEST_CONNECT_PORT=8289

# Image versions are explicit and can be advanced only after verification.
NODE_VERSION=22.17.0
POSTGRES_IMAGE=postgres:17.10-alpine
INNGEST_IMAGE=inngest/inngest:v1.19.2
AO_IMAGE=agentic-operator:local

# AO-owned durable Postgres. DATABASE_URL uses the Docker service name
# `ao-postgres` (deliberately not plain "postgres" — shared external networks
# may already have a container with that name); URL-encode special characters
# in the password.
AO_POSTGRES_USER=ao
AO_POSTGRES_PASSWORD=replace-with-a-long-random-password
AO_POSTGRES_DB=ao
AO_POSTGRES_PORT=5433
DATABASE_URL=postgresql://ao:replace-with-a-long-random-password@ao-postgres:5432/ao?connect_timeout=5
DATABASE_SCHEMA_SYNC=1

# Local self-hosted Inngest dev server keys. The server is intended for a
# trusted LAN only; do not expose ports 8288/8289 directly to the public web.
INNGEST_EVENT_KEY=replace-with-a-random-local-event-key
INNGEST_SIGNING_KEY=replace-with-a-random-local-signing-key

# ── Inngest mode ──────────────────────────────────────────────────────
# bundled-inngest (default): compose starts its own persistent dev server.
# SHARED mode — the machine already runs one Inngest for AO + RAAS together
# (architecture rule: ONE shared instance). Then:
#   1. clear the profile:            COMPOSE_PROFILES=
#   2. point both URLs at the shared instance, e.g. via the host bridge:
#        INNGEST_BASE_URL=http://host.docker.internal:8288
#        INNGEST_SERVE_ORIGIN=http://host.docker.internal:3002
#      or, when joining the RAAS Docker network with
#      docker-compose.shared-inngest.yml, by container name:
#        INNGEST_BASE_URL=http://raas-inngest:8288
#        INNGEST_SERVE_ORIGIN=http://ao-v2-app:3002
COMPOSE_PROFILES=bundled-inngest
# INNGEST_BASE_URL=
# INNGEST_SERVE_ORIGIN=

# Durable monitor/archive behavior. A retention value of 0 means that record
# family is retained indefinitely. Postgres is the primary record store;
# AO_LOG_DIR is mounted as a named volume for full JSONL agent logs.
ARCHIVE_INTERVAL_MS=30000
ARCHIVE_WINDOW_HOURS=168
ARCHIVE_EVENT_LIMIT=1000
ARCHIVE_RUN_LIMIT=1000
ARCHIVE_TRACE_CONCURRENCY=4
MONITOR_SWEEP_INTERVAL_MS=60000
MONITOR_EVAL=1
NOTIFICATION_RETENTION_DAYS=0
MONITOR_EVAL_RETENTION_DAYS=0
LOG_EVENT_RETENTION_DAYS=0

# LLM gateway (or remove AI_* and set OPENAI_API_KEY instead).
AI_BASE_URL=https://replace-with-your-openai-compatible-gateway.example/v1
AI_API_KEY=replace-with-your-llm-key
AI_MODEL=replace-with-your-model-id
# OPENAI_API_KEY=

# Allmeta is AO's HTTP gateway to Neo4j. When the Allmeta stack runs in
# Docker on the SAME host as this deployment (e.g. the Mac Studio setup),
# use host.docker.internal so AO containers can reach it through the host:
#   ALLMETA_BASE_URL=http://host.docker.internal:3500
ALLMETA_BASE_URL=https://replace-with-your-allmeta-host.example
ALLMETA_API_KEY=replace-with-your-allmeta-token
ALLMETA_DOMAIN=RAAS-v1

# RoboHire resume parse/match API. Base URL has NO /v1 suffix (the client
# appends /api/v1 itself; adding /v1 here causes 404s). match-resume has been
# measured at ~195s, so the timeout must stay >= 300000.
ROBOHIRE_API_BASE_URL=https://api.gohire.top
ROBOHIRE_API_KEY=replace-with-your-robohire-key
ROBOHIRE_TIMEOUT_MS=300000

# Partner-owned business Postgres (its seven RAAS tables must already exist).
RAAS_POSTGRES_URL=postgresql://replace-user:replace-password@replace-partner-host:5432/replace-database?connect_timeout=5
RAAS_DEFAULT_EMPLOYEE_ID=replace-with-a-real-recruiter-id

# Partner MinIO/S3-compatible resume storage. MINIO_ENDPOINT has no scheme.
MINIO_ENDPOINT=replace-minio-host
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Protect externally callable administration/execution endpoints.
AGENT_EXECUTION_API_KEY=replace-with-a-long-random-execution-key
FACTORY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
FACTORY_AUTH_REQUIRED=1

# Production safety gates.
STUB_AGENTS=0
RULE_CHECK_BYPASS=false
AO_ENABLE_UNSAFE_DEV_ROUTES=0
RAAS_BRIDGE_ENABLED=0
RAAS_FORWARD_ENABLED=0

# Candidate identity / dedup / lock behavior. These change who counts as the
# "same person" and whether a locked candidate is suppressed, so keep the
# defaults below on a first deployment and flip them only deliberately.
#   CANDIDATE_IDENTITY_ENABLED  default ON — set 0 only to disable the
#                               three-tier identity agent entirely.
#   LOCK_CHECK_ENABLED=1        call RMHR and record a lock decision
#                               (dark launch: observe only, never blocks).
#   CANDIDATE_LOCK_PG_WRITE=1   persist lock decisions to CandidateLock.
#   LOCK_CHECK_ENFORCE=1        actually enforce: a lock-only decision
#                               suppresses RESUME_PROCESSED.
#   DEDUP_PHONE_PRIMARY=1       dedup candidates by phone alone (RMHR
#                               alignment). One-way door: it changes the
#                               stored identity key, so backfill
#                               `mobile_normalized` in the partner database
#                               BEFORE enabling it.
CANDIDATE_IDENTITY_ENABLED=1
LOCK_CHECK_ENABLED=0
CANDIDATE_LOCK_PG_WRITE=0
LOCK_CHECK_ENFORCE=0
DEDUP_PHONE_PRIMARY=0

# Agent factory v3 (optional tuning; safe defaults when unset).
# FACTORY_STRONG_MODEL upgrades design/review stages to a stronger model id
# routed by your AI_BASE_URL gateway; unset = everything uses AI_MODEL.
# FACTORY_EXEC_GENERATED=0 disables executing factory-generated agent code.
# EGRESS_ALLOW_HOSTS is a comma-separated allowlist that widens the SSRF
# guard for AI-authored HTTP tools; leave unset to keep fail-closed.
# FACTORY_STRONG_MODEL=
# FACTORY_EXEC_GENERATED=1
# EGRESS_ALLOW_HOSTS=

# Optional integrations; keep disabled until their real endpoints are ready.
NEO4J_SYNC_ENABLED=0
# NEO4J_INSTANCE_URI=bolt://replace-neo4j-host:7687
# NEO4J_INSTANCE_USER=neo4j
# NEO4J_INSTANCE_PASSWORD=
# NEO4J_INSTANCE_DATABASE=neo4j
# NEXT_PUBLIC_NEO4J_BROWSER_URL=https://replace-neo4j-host/browser/
# RMHR_INTERNAL_HOST=
# RMHR_INTERNAL_API_KEY=
# NOTIFY_CHANNELS=in_app
