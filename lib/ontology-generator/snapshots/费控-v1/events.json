[
  {
    "name": "EXPENSE_SUBMITTED",
    "description": "触发条件：报销人在启费通把报销单（出差报销 ECA / 普通报销 OEP）从 DRAFT 提交。系统动作：智控建案，一对一生成费控审核案件（FK），落库报销单及明细行快照，单据进 OCR。伴随状态变化：报销单与案件从 DRAFT/SUBMITTED 推进至 OCR_RUNNING。",
    "payload": {
      "source_action": "submitExpenseClaim",
      "event_data": [
        {
          "name": "expense_claim_id",
          "type": "String",
          "target_object": "Expense_Claim"
        },
        {
          "name": "claim_type",
          "type": "String",
          "target_object": "Expense_Claim"
        },
        {
