{
  "metadata": {
    "domain": "recruit-gen-v1",
    "source": "测试域:以 server/inngest/agents 的 6 个真实招聘 agent 为答案键,验证 agents 生成 agents。objects/rules 沿用 招聘 既有交付物未改。",
    "workflow_count": 6,
    "message": "recruit-gen-v1 测试域,6-agent 工作流。事件链:RESUME_DOWNLOADED→parseResume→RESUME_PROCESSED→ruleCheck→MATCH_RULE_CHECK_PASSED→matchResume→MATCH_PASSED_NEED_INTERVIEW;REQUIREMENT_LOGGED→createJd→JD_GENERATED;INTERVIEW_INVITATION_REQUESTED→inviteInterview;CANDIDATE_IDENTITY_REQUESTED→candidateIdentity。",
    "entry_events": ["RESUME_DOWNLOADED", "CANDIDATE_IDENTITY_REQUESTED", "REQUIREMENT_LOGGED", "CLARIFICATION_READY", "JD_REJECTED", "INTERVIEW_INVITATION_REQUESTED"],
    "terminal_events": ["RESUME_LOCKED_CONFLICT", "MATCH_RULE_CHECK_FAILED", "MATCH_PASSED_NEED_INTERVIEW", "MATCH_FAILED", "INTERVIEW_INVITATION_SENT", "INTERVIEW_INVITATION_FAILED", "JD_GENERATED", "CANDIDATE_IDENTITY_CHECKED"]
  },
  "workflows": [
    { "id": "RG-1", "name": "parseResume", "description": "去重锁定 + RoboHire 解析 + 落库,发 RESUME_PROCESSED。", "actor": ["Agent"], "trigger": ["RESUME_DOWNLOADED"], "actions": [{ "order": "1", "name": "lockAndDedup", "description": "三级去重 + 归属锁定", "type": "logic", "condition": "收到 RESUME_DOWNLOADED" }, { "order": "2", "name": "downloadAndParse", "description": "MinIO 取件 → RoboHire 解析", "type": "logic", "condition": "去重通过" }, { "order": "3", "name": "persist", "description": "落库 + 镜像,发 RESUME_PROCESSED", "type": "logic", "condition": "解析完成" }], "triggered_event": ["RESUME_PROCESSED", "RESUME_LOCKED_CONFLICT"] },
    { "id": "RG-2", "name": "ruleCheck", "description": "匹配前规则校验,通过发 MATCH_RULE_CHECK_PASSED。", "actor": ["Agent"], "trigger": ["RESUME_PROCESSED"], "actions": [{ "order": "1", "name": "loadContext", "description": "读需求与简历", "type": "logic", "condition": "收到 RESUME_PROCESSED" }, { "order": "2", "name": "evaluateRules", "description": "本体+Neo4j+LLM 评估规则", "type": "logic", "condition": "上下文就绪" }, { "order": "3", "name": "route", "description": "PASS/FAIL 路由", "type": "logic", "condition": "评估完成" }], "triggered_event": ["MATCH_RULE_CHECK_PASSED", "MATCH_RULE_CHECK_FAILED"] },
    { "id": "RG-3", "name": "matchResume", "description": "RoboHire 匹配评分,达标发 MATCH_PASSED_NEED_INTERVIEW。", "actor": ["Agent"], "trigger": ["MATCH_RULE_CHECK_PASSED"], "actions": [{ "order": "1", "name": "score", "description": "RoboHire 评分", "type": "logic", "condition": "规则通过" }, { "order": "2", "name": "route", "description": "按阈值路由", "type": "logic", "condition": "评分完成" }], "triggered_event": ["MATCH_PASSED_NEED_INTERVIEW", "MATCH_FAILED"] },
    { "id": "RG-4", "name": "inviteInterview", "description": "发送面试邀约,成功发 INTERVIEW_INVITATION_SENT。", "actor": ["Agent"], "trigger": ["INTERVIEW_INVITATION_REQUESTED"], "actions": [{ "order": "1", "name": "backfill", "description": "回填简历/JD", "type": "logic", "condition": "事件较薄" }, { "order": "2", "name": "send", "description": "RoboHire 发送邀约", "type": "logic", "condition": "字段就绪" }, { "order": "3", "name": "record", "description": "建面试记录 + 标记", "type": "logic", "condition": "发送成功" }], "triggered_event": ["INTERVIEW_INVITATION_SENT", "INTERVIEW_INVITATION_FAILED"] },
    { "id": "RG-5", "name": "createJd", "description": "RoboHire 生成 JD + 拆技能数组,发 JD_GENERATED。", "actor": ["Agent"], "trigger": ["REQUIREMENT_LOGGED", "CLARIFICATION_READY", "JD_REJECTED"], "actions": [{ "order": "1", "name": "generate", "description": "RoboHire 生成 JD", "type": "logic", "condition": "收到需求/驳回" }, { "order": "2", "name": "persist", "description": "拆技能 + 落库 + 镜像", "type": "logic", "condition": "JD 生成" }], "triggered_event": ["JD_GENERATED"] },
    { "id": "RG-6", "name": "candidateIdentity", "description": "候选人查重(精确 + LLM 模糊),发 CANDIDATE_IDENTITY_CHECKED。", "actor": ["Agent"], "trigger": ["CANDIDATE_IDENTITY_REQUESTED"], "actions": [{ "order": "1", "name": "exactCompare", "description": "手机/邮箱精确比对", "type": "logic", "condition": "收到查重请求" }, { "order": "2", "name": "fuzzyJudge", "description": "LLM 字段等价判定", "type": "logic", "condition": "精确未命中" }], "triggered_event": ["CANDIDATE_IDENTITY_CHECKED"] }
  ]
}
