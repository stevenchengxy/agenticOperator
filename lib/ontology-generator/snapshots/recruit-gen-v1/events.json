[
  { "name": "RESUME_DOWNLOADED", "description": "渠道已下载候选人简历原件,触发 parseResume(入口事件)。", "payload": { "source_action": "", "event_data": [{ "name": "resume_file_path", "type": "String", "target_object": "Resume" }, { "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [] } },
  { "name": "CANDIDATE_IDENTITY_REQUESTED", "description": "请求对候选人做查重判定(入口/invoke)。", "payload": { "source_action": "", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }], "state_mutations": [] } },
  { "name": "REQUIREMENT_LOGGED", "description": "招聘需求已登记,触发 createJD(入口事件)。", "payload": { "source_action": "", "event_data": [{ "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [] } },
  { "name": "CLARIFICATION_READY", "description": "需求澄清完成,触发 createJD(入口事件)。", "payload": { "source_action": "", "event_data": [{ "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [] } },
  { "name": "JD_REJECTED", "description": "JD 被驳回需重生成,触发 createJD(入口事件)。", "payload": { "source_action": "", "event_data": [{ "name": "job_posting_id", "type": "String", "target_object": "Job_Posting" }], "state_mutations": [] } },
  { "name": "INTERVIEW_INVITATION_REQUESTED", "description": "RAAS/HSM 审批后请求发起面试邀约,触发 inviteInterview(入口事件)。", "payload": { "source_action": "", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [] } },

  { "name": "RESUME_PROCESSED", "description": "简历解析完成,候选人与简历就绪,触发 ruleCheck。", "payload": { "source_action": "parseResume", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "resume_id", "type": "String", "target_object": "Resume" }, { "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [{ "target_object": "Resume", "mutation_type": "CREATE_OR_MODIFY", "impacted_properties": ["resume_id", "skill_tags"] }] } },
  { "name": "RESUME_LOCKED_CONFLICT", "description": "候选人归属冲突,仅登记不推进(终态)。", "payload": { "source_action": "parseResume", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "locked_by", "type": "String", "target_object": "Employee" }], "state_mutations": [] } },
  { "name": "MATCH_RULE_CHECK_PASSED", "description": "规则校验通过,进入深度匹配。", "payload": { "source_action": "ruleCheck", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [{ "target_object": "Candidate_Match_Result", "mutation_type": "CREATE", "impacted_properties": ["rule_check_result"] }] } },
  { "name": "MATCH_RULE_CHECK_FAILED", "description": "规则校验未通过(合法业务结论,终态)。", "payload": { "source_action": "ruleCheck", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "rule_check_reason", "type": "String", "target_object": null }], "state_mutations": [{ "target_object": "Candidate_Match_Result", "mutation_type": "CREATE", "impacted_properties": ["rule_check_result", "rule_check_reason"] }] } },
  { "name": "MATCH_PASSED_NEED_INTERVIEW", "description": "匹配达标且需面试(终态,后续由 RAAS/HSM 接力)。", "payload": { "source_action": "matchResume", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "match_score", "type": "Float", "target_object": "Candidate_Match_Result" }], "state_mutations": [{ "target_object": "Candidate_Match_Result", "mutation_type": "MODIFY", "impacted_properties": ["match_status", "match_score"] }] } },
  { "name": "MATCH_FAILED", "description": "匹配不达标(合法业务结论,终态)。", "payload": { "source_action": "matchResume", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }], "state_mutations": [{ "target_object": "Candidate_Match_Result", "mutation_type": "MODIFY", "impacted_properties": ["match_status"] }] } },
  { "name": "INTERVIEW_INVITATION_SENT", "description": "面试邀约已发送(终态)。", "payload": { "source_action": "inviteInterview", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "interview_record_id", "type": "String", "target_object": "Interview_Record" }], "state_mutations": [{ "target_object": "Interview_Record", "mutation_type": "CREATE", "impacted_properties": ["invitation_status"] }] } },
  { "name": "INTERVIEW_INVITATION_FAILED", "description": "面试邀约发送失败(终态)。", "payload": { "source_action": "inviteInterview", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "error_reason", "type": "String", "target_object": null }], "state_mutations": [] } },
  { "name": "JD_GENERATED", "description": "JD 已生成待发布(终态)。", "payload": { "source_action": "createJd", "event_data": [{ "name": "job_posting_id", "type": "String", "target_object": "Job_Posting" }, { "name": "job_requisition_id", "type": "String", "target_object": "Job_Requisition" }], "state_mutations": [{ "target_object": "Job_Posting", "mutation_type": "CREATE_OR_MODIFY", "impacted_properties": ["jd_content", "must_have_skills"] }] } },
  { "name": "CANDIDATE_IDENTITY_CHECKED", "description": "候选人查重完成,返回判定(终态/蓝图闭合)。", "payload": { "source_action": "candidateIdentity", "event_data": [{ "name": "candidate_id", "type": "String", "target_object": "Candidate" }, { "name": "samePerson", "type": "Boolean", "target_object": null }], "state_mutations": [{ "target_object": "OntologyRuleCheck", "mutation_type": "CREATE", "impacted_properties": ["decision"] }] } }
]
