// AO unified Prisma schema (P3 foundation)
//
// Design principles (from spec):
// - Single SQLite file `data/ao.db` for dev (env-overridable for prod Postgres).
// - Only runtime/audit/gateway models from EM (Q1: no Editor).
// - WS workflow models, minus Copilot (Q2) and test/studio/simulation tables.
// - All Postgres-specific (@db.Text, @db.VarChar(N), arrays) stripped for SQLite.
// - JSON columns stored as TEXT, parsed by service layer.
//
// P3 progress: foundation (~10 of ~25 final tables). Remaining tables and
// migration plan documented in docs/superpowers/specs/2026-04-27-ao-int-p3-monorepo-merge-design.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 2026-05-28: migrated SQLite → local Postgres (durable, concurrent-safe).
  // JSON columns stay TEXT/String so the service layer (which JSON.parse-es
  // them) is engine-agnostic; only the provider + driver adapter change.
  provider = "postgresql"
}

// =====================================================================
// WS — Workflow runtime
// =====================================================================

model WorkflowRun {
  id               String    @id @default(cuid())
  triggerEvent     String
  triggerData      String    // JSON
  // status values per spec §13: running | suspended | timed_out | completed
  // | failed | paused | interrupted
  status           String    @default("running")
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  lastActivityAt   DateTime  @default(now())
  suspendedReason  String?

  steps            WorkflowStep[]
  activities       AgentActivity[]

  @@index([status])
  @@index([startedAt])
  @@index([lastActivityAt])
}

model WorkflowStep {
  id          String    @id @default(cuid())
  runId       String
  run         WorkflowRun @relation(fields: [runId], references: [id])
  nodeId      String
  stepName    String
  status      String    // pending | running | completed | failed | retrying
  input       String?   // JSON
  output      String?   // JSON
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  @@index([runId])
  @@index([nodeId])
  @@index([status])
}

model AgentActivity {
  id        String   @id @default(cuid())
  runId     String?
  run       WorkflowRun? @relation(fields: [runId], references: [id])
  nodeId    String
  agentName String
  type      String
  narrative String
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([nodeId])
  @@index([agentName])
  @@index([type])
  @@index([createdAt])
}

model HumanTask {
  id            String    @id @default(cuid())
  runId         String
  nodeId        String
  nodeName      String
  title         String
  payload       String    // JSON
  aiOpinion     String?   // JSON
  status        String    @default("pending") // pending | approved | rejected
  assignee      String?
  result        String?   // JSON
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  deadline      DateTime?
  approveEvent  String?
  rejectEvent   String?
  eventData     String?   // JSON
  resolvedBy    String?

  // EM v2 spec §10.4 — when an agent escalates via business rules, it must
  // record the EventInstance that triggered the escalation. Lets /inbox
  // cards link back to /events/:name/instances/:id. Optional today (legacy
  // tasks lack it) but populated by all new agent code paths.
  triggeringEventInstanceId String?  @map("triggering_event_instance_id")
  triggeringEventName       String?  @map("triggering_event_name")

  @@index([runId])
  @@index([status])
  @@index([nodeId])
  @@index([assignee])
  @@index([triggeringEventInstanceId])
}

model ChatbotSession {
  id                 String    @id @default(cuid())
  sessionType        String
  status             String    @default("open")
  correlationId      String
  humanTaskId        String?
  hitlRequestId      String?
  parentSessionId    String?
  clientId           String?
  assignedTo         String?
  aiAnalysis         String?   // JSON
  questions          String    // JSON
  collectedAnswers   String    @default("{}")
  conversationLog    String    @default("[]")
  resolvedPath       String?
  resolvedBy         String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deadline           DateTime?

  @@index([correlationId])
  @@index([status])
  @@index([humanTaskId])
}

// Living KB rules (used by processResume.rule etc.)
model CandidateLock {
  id           String   @id @default(cuid())
  candidateId  String
  clientId     String
  jdId         String?
  recruiterId  String
  expiresAt    DateTime
  reason       String?
  releasedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([candidateId, clientId])
  @@index([clientId, expiresAt])
}

model Blacklist {
  id           String   @id @default(cuid())
  candidateId  String
  clientId     String?
  reason       String
  addedBy      String
  createdAt    DateTime @default(now())

  @@index([candidateId, clientId])
}

// =====================================================================
// EM — Audit & DLQ (runtime only, no Editor)
// =====================================================================

model AuditLog {
  id           String   @id @default(cuid())
  eventName    String
  traceId      String
  payload      String   // JSON
  payloadDigest String
  source       String   // 'ws' | 'em' | 'external'
  createdAt    DateTime @default(now())

  @@index([eventName])
  @@index([traceId])
  @@index([createdAt])
}

model DLQEntry {
  id        String   @id @default(cuid())
  eventName String
  reason    String
  payload   String   // JSON
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([eventName])
  @@index([resolvedAt])
}

model DedupCache {
  id          String   @id @default(cuid())
  dedupKey    String   @unique
  eventName   String
  firstSeenAt DateTime @default(now())
  hitCount    Int      @default(1)

  @@index([eventName])
  @@index([firstSeenAt])
}

// =====================================================================
// WS — Living KB Layer 4 (Episodes) + AgentConfig
// =====================================================================

// One row per agent execution. Powers /api/trace LLM-trace tab and the
// agent-tuning loop (judgeScore + reviewerFeedback).
model AgentEpisode {
  id               String   @id @default(cuid())
  agentName        String
  runId            String?
  workflowId       String?
  clientId         String?
  input            String   // JSON
  output           String   // JSON
  toolTrace        String?  // JSON
  ruleEvaluations  String?  // JSON
  durationMs       Int
  modelUsed        String?
  tokenUsage       String?  // JSON: {prompt, completion, total}
  judgeScore       Float?
  judgeRationale   String?
  judgedAt         DateTime?
  reviewerFeedback String?
  reviewedBy       String?
  reviewedAt       DateTime?
  isFewShot        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([agentName])
  @@index([runId])
  @@index([clientId, agentName])
  @@index([judgeScore])
  @@index([isFewShot])
  @@index([createdAt])
}

// Per-agent runtime overrides (temperature, prompt append, tier, retries).
// Edited via /api/agent-config (P3 chunk 4) and ConfigAdvisor agent.
model AgentConfig {
  id               String  @id  // matches WorkflowAgentDef.id
  enabled          Boolean @default(true)
  description      String?
  temperature      Float?
  maxRetries       Int?
  tier             String?  // "lite" | "standard" | "pro"
  maxOutputTokens  Int?
  promptAppend     String?
  skillOverrides   String?  // JSON: Record<string, Partial<AIConfig>>
  tuningNotes      String?
  lastAdvisedAt    DateTime?
  adviceAccepted   Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  history          AgentConfigHistory[]

  // Phase 2 (Manage): throttle support — stub-factory checks this at handler start.
  // If throttleUntil > now(), the agent sleeps until that time before processing.
  throttleUntil    DateTime?
  throttleReason   String?
}

model AgentConfigHistory {
  id        String   @id @default(cuid())
  agentId   String
  config    AgentConfig @relation(fields: [agentId], references: [id])
  changedBy String   @default("user")
  before    String   // JSON
  after     String   // JSON
  reason    String?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

// Phase 0: Agent 版本表 — 配置快照 + 未来 codegen 落库目标。
// 见 docs/2026-05-25-ao-behavior-codegen-research.md §8.1
model AgentVersion {
  id           String   @id @default(cuid())
  // short = AGENT_MAP 里的 short code (e.g. "JDGenerator")
  // slug  = Inngest function id (e.g. "create-jd-agent") — 也是 AgentConfig.id
  short        String
  slug         String
  versionLabel String   // 'v1.9.4' 或 '2026-05-25-1830' 自动生成
  status       String   @default("draft")  // 'draft' | 'active' | 'archived'

  // Phase 0 实际使用
  configJson   String?  // JSON: AgentConfig 快照
  configHash   String?  // sha256(configJson) — 用于去重
  capturedFrom String?  // 'current-config' | 'manual' | 'codegen'
  notes        String?

  // Phase 1+ 留空字段 (nullable,Phase 0 不写)
  codeBlob     String?
  codeHash     String?
  specJson     String?
  promptText   String?
  modelUsed    String?

  // Provenance
  generatedBy  String   @default("operator-unknown")
  createdAt    DateTime @default(now())
  deployedAt   DateTime?

  @@unique([short, versionLabel])
  @@index([short, createdAt])
  @@index([slug])
  @@index([status])
}

// =====================================================================
// EM — Runtime / Gateway / Outbound (Q1: no Editor)
// =====================================================================

// EM event-definition table; AO reads ACTIVE rows only as event-contract
// cache. No edit operations exposed by AO.
//
// v2 spec additions (additive, optional):
//   activeVersionsJson: JSON array of version strings, descending (latest first)
//   schemasByVersionJson: JSON object { "2.0": <jsonschema>, "1.0": ... }
//   publishersJson / subscribersJson: JSON string[]
//   source: 'neo4j' (synced) | 'hardcoded' (fallback) | 'manual'
//   syncedAt: last successful Neo4j sync
//   retiredAt: hide from UI when set
model EventDefinition {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  payload     String  // JSON
  extraJson   String  @default("{}") @map("extra_json")
  status      String  @default("DRAFT")
  version     String  @default("1.0")
  sortOrder   Int     @default(0) @map("sort_order")
  batchId     String? @map("batch_id")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  // v2 additive fields
  activeVersionsJson    String?   @map("active_versions_json")    // JSON: string[]
  schemasByVersionJson  String?   @map("schemas_by_version_json") // JSON: Record<version, JsonSchema>
  publishersJson        String?   @map("publishers_json")         // JSON: string[]
  subscribersJson       String?   @map("subscribers_json")        // JSON: string[]
  source                String    @default("hardcoded")            // 'neo4j' | 'hardcoded' | 'manual'
  syncedAt              DateTime? @map("synced_at")
  retiredAt             DateTime? @map("retired_at")

  // Change detection: SHA-256(description + payload + extraJson + publishers
  // + subscribers). Sync compares this against the new computed hash to
  // decide whether the row actually changed (vs. just got re-touched). If
  // it changed, lastChangedAt is set to NOW().
  contentHash           String?   @map("content_hash")
  lastChangedAt         DateTime? @map("last_changed_at")

  // Allmeta sets `is_breaking_change` on the Event node when a published
  // version contains a non-back-compatible mutation. We surface this so
  // /events shows a red badge and ops knows to verify nothing in flight
  // depends on the old shape.
  isBreakingChange      Boolean   @default(false) @map("is_breaking_change")

  @@index([source, syncedAt])
  @@index([retiredAt])
  @@index([lastChangedAt])
  @@map("events")
}

// EM v2 §9 — EventInstance: business-level publish trail. One row per
// em.publish() call. Inngest stores the full payload; this table stores
// summary + provenance + lifecycle status for UI / audit / replay.
model EventInstance {
  id                  String    @id @default(uuid())
  externalEventId     String?   @unique @map("external_event_id")
  name                String
  source              String                              // "raas-bridge" | "rpa.matchResumeAgent" | ...
  status              String                              // accepted | rejected_schema | rejected_filter | duplicate | meta_rejection | em_degraded
  rejectionType       String?   @map("rejection_type")    // SCHEMA_VALIDATION_FAILED | FILTER_REJECTED
  rejectionReason     String?   @map("rejection_reason")
  schemaErrors        String?   @map("schema_errors")     // JSON: ZodIssue[]
  schemaVersionUsed   String?   @map("schema_version_used")
  triedVersions       String?   @map("tried_versions")    // JSON: string[]
  causedByEventId     String?   @map("caused_by_event_id")
  causedByName        String?   @map("caused_by_name")
  payloadSummary      String?   @map("payload_summary")   // JSON snippet
  ts                  DateTime  @default(now())

  @@index([name, ts])
  @@index([status])
  @@index([causedByEventId])
  @@index([source])
  @@map("event_instances")
}

// EM library health snapshot (singleton row id='singleton').
// Driven by server/em/degraded-mode.ts. UI reads to render AppBar dot etc.
model EmSystemStatus {
  id                String    @id @default("singleton")
  state             String    @default("healthy")  // 'healthy' | 'degraded' | 'down'
  degradedSince     DateTime? @map("degraded_since")
  lastError         String?   @map("last_error")
  lastErrorAt       DateTime? @map("last_error_at")
  fallbackCount24h  Int       @default(0) @map("fallback_count_24h")
  publishCount24h   Int       @default(0) @map("publish_count_24h")
  rejectCount24h    Int       @default(0) @map("reject_count_24h")
  // Neo4j sync sub-status
  neo4jLastSyncAt   DateTime? @map("neo4j_last_sync_at")
  neo4jLastError    String?   @map("neo4j_last_error")
  neo4jUpsertedLast Int       @default(0) @map("neo4j_upserted_last")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("em_system_status")
}

model GatewayFilterRule {
  id               String  @id @default(uuid())
  ruleType         String  @map("rule_type") // whitelist | blacklist | auto_map
  eventNamePattern String  @map("event_name_pattern")
  targetEventId    String? @map("target_event_id")
  enabled          Int     @default(1)
  description      String?
  createdAt        String  @map("created_at")

  @@map("gateway_filter_rules")
}

// Phase 7 outbound — terminal agents enqueue here for external delivery.
model OutboundEvent {
  id              String  @id @default(uuid())
  correlationId   String  @map("correlation_id")
  eventName       String  @map("event_name")
  eventId         String  @map("event_id")
  payload         String  // JSON
  expectAckEvent  String? @map("expect_ack_event")
  status          String  @default("sent") // sent | pending | acknowledged | timeout | failed | chained
  sentAt          String  @map("sent_at")
  ackReceivedAt   String? @map("ack_received_at")
  ackMessageId    Int?    @map("ack_message_id")
  timeoutSeconds  Int     @default(300) @map("timeout_seconds")
  extraMetadata   String? @map("extra_metadata") // JSON

  @@index([correlationId])
  @@index([status])
  @@map("outbound_events")
}

// Inbound RaaS messages from external Kafka — full audit trail.
model RaasMessage {
  id                Int     @id @default(autoincrement())
  receivedAt        String  @map("received_at")
  topic             String
  partition         Int     @default(0)
  offset            Int
  key               String?
  data              String  // JSON
  classification    String? // matched_valid | matched_invalid | unrecognized | parse_error
  matchedEventDefId String? @map("matched_event_def_id")
  validationErrors  String? @map("validation_errors") // JSON array
  classifiedAt      String? @map("classified_at")
  ingestionStatus   String? @map("ingestion_status") // pending | ingested | failed | skipped
  ingestedAt        String? @map("ingested_at")

  @@index([classification], map: "idx_raas_classification")
  @@index([ingestionStatus], map: "idx_raas_ingestion_status")
  @@map("raas_messages")
}

model RejectedMessage {
  id           String  @id
  rawPayload   String? @map("raw_payload")
  rejectReason String  @map("reject_reason") // malformed_json | missing_event_name | unknown_source | out_of_domain
  source       String?
  receivedAt   String  @map("received_at")

  @@map("rejected_messages")
}

model IngestionConfig {
  id         String @id @default(uuid())
  eventName  String @unique @map("event_name")
  autoIngest Int    @default(0) @map("auto_ingest")
  createdAt  String @map("created_at")
  updatedAt  String @map("updated_at")

  @@map("ingestion_configs")
}

model HealthIncident {
  id            String  @id
  healthState   String  @map("health_state") // YELLOW | RED
  failedEvent   String? @map("failed_event")
  failureReason String? @map("failure_reason")
  agentName     String? @map("agent_name")
  sampledAt     String  @map("sampled_at")
  resolved      Int     @default(0)

  @@map("health_incidents")
}

model ExecutionTrace {
  id           String  @id @default(uuid())
  triggerEvent String  @map("trigger_event")
  mode         String  @default("simulated") // simulated | live
  steps        String  @default("[]") // JSON array
  summary      String  @default("{}") // JSON
  startedAt    String  @map("started_at")
  completedAt  String? @map("completed_at")
  maxDepth     Int     @default(10) @map("max_depth")

  @@map("execution_traces")
}

// =====================================================================
// Recruitment workflow: requirement → JD pipeline (workflow nodes 1-2 → 4)
// =====================================================================

model JobRequisition {
  id              String   @id                 // requisition_id (uuid or short)
  client          String                       // 客户名 / company name
  title           String                       // 岗位名称
  city            String?
  headcount       Int?                         // 计划招聘人数
  salaryRangeMin  Int?                         // CNY/月
  salaryRangeMax  Int?
  responsibilities String?                     // 岗位职责（多行 markdown）
  requirements     String?                     // 任职要求（硬性 + 软性）
  niceToHaves      String?                     // 加分项
  source           String   @default("manual") // manual | sync
  status           String   @default("pending_clarification")
                                                // pending_clarification | clarified | jd_ready | published | closed
  rawPayload       String?                     // 原始 REQUIREMENT_LOGGED payload (JSON string)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  jds              JobDescription[]
}

model JobDescription {
  id                   String   @id              // jd_id (uuid)
  requisitionId        String                    // FK → JobRequisition.id
  client               String
  title                String                    // 标准化职位名称
  jdContent            String                    // 完整 JD 文本（markdown / JSON-string）
  responsibilities     String?
  requirements         String?
  niceToHaves          String?
  searchKeywords       String?                   // top-5 keywords as comma-separated string
  qualityScore         Float?
  qualitySuggestions   String?                   // JSON string array
  marketCompetitiveness String?                  // 高 / 中 / 低

  // ── 结构化匹配签名（per JOB_REQUISITION_GENERATED.payload） ──
  mustHaveSkills       String?                   // JSON string of string[]
  niceToHaveSkills     String?                   // JSON string of string[]
  degreeRequirement    String?                   // 本科及以上 / 硕士及以上 / 不限
  educationRequirement String?                   // 计算机相关专业 / 不限
  languageRequirements String?                   // 英语读写流利 / 无
  negativeRequirement  String?                   // 排除条件
  workYears            Int?                      // 最少工作年限
  expectedLevel        String?                   // T3-T4 / 中3-高1
  interviewMode        String?                   // 现场面试 / 视频面试

  status               String   @default("draft") // draft | approved | rejected | published
  generatorMode        String?                   // robohire | llm | manual
  generatorModel       String?                   // model used (e.g. gemini-3-flash-preview)
  generatorRequestId   String?
  generatorDurationMs  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  requisition          JobRequisition @relation(fields: [requisitionId], references: [id])
}

// =====================================================================
// Behavior axis — Phase 1 (2026-05-14) + Phase 2 additions
// =====================================================================

// Lightweight alert lifecycle table for Monitor Agent + Manager Agent.
// Dedup contract: one unresolved row per alertKey (resolvedAt IS NULL).
// Lifecycle: firstSeenAt → lastSeenAt (updated on repeat fire) → resolvedAt.
model BehaviorAlert {
  id          String   @id @default(cuid())
  alertKey    String                                    // dedupe key e.g. 'agent_error_rate.JDGenerator'
  severity    String                                    // 'warning' | 'error'
  ruleId      String                                    // which heuristic fired
  details     String                                    // JSON: per-rule context
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolvedAt  DateTime?
  managerActionTaken String?                            // 'monitor' | 'escalate' | 'throttle' | 'auto_restart'
  managerActionAt    DateTime?

  // Phase 2: auto_restart loop guard — prevent runaway restart cycles
  autoRestartCount    Int       @default(0)
  lastAutoRestartAt   DateTime?

  @@unique([alertKey, resolvedAt])                      // one unresolved alert per key
  @@index([severity])
  @@index([firstSeenAt])
}

// =====================================================================
// Rule Check audit (restored from Steven branch on 2026-05-14).
// AO's private LLM-rule-check audit log — corresponds to /rule-check page.
// Per the v0_1_010 alignment decision (alignment doc §3.5),
// Candidate_Match_Result on Allmeta stores only 4 conclusion fields;
// full audit details (rules evaluated / LLM I/O / failure reasons) live here.
// =====================================================================

model RuleCheckAudit {
  // 主键 + 关联
  audit_id              String   @id
  run_id                String
  scenario_id           String?
  trace_id              String?

  // 业务 ID(soft link 到 Neo4j 实体节点)
  upload_id             String
  candidate_id          String
  resume_id             String
  job_requisition_id    String

  // dims(从 RAAS getRequirementsAgentView extract)
  client_name           String?
  // 可读客户名(写入时由 resolveClientName 解析并持久化;读时不再实时查 partner-pg)
  client_display_name   String?
  business_group        String?
  studio                String?

  // 决策
  decision              String   // PASS | FAIL
  llm_decision          String   // PASS | FAIL | KEEP | DROP | PAUSE | UNKNOWN
  failure_reasons       String   // JSON array

  // LLM observability
  llm_model             String
  llm_duration_ms       Int
  llm_prompt_tokens     Int?
  llm_completion_tokens Int?
  parse_error           String?

  // 规则集
  rules_evaluated       Int
  rules_total_in_ontology Int
  rule_source           String   // neo4j-direct | ontology-api | json-fallback
  partial_resume_fields String   // JSON array
  filtered_out_rules    String?  // JSON array
  rule_provenance       String?  // JSON array of {rule_id, tier, included, reason}

  // 完整 input snapshot
  parsed_resume_json    String?
  job_requisition_json  String?

  // LLM I/O 全文
  user_prompt           String?
  system_prompt         String?
  llm_raw_text          String?

  // Augmentation + lineage
  resume_augmentation   String?
  parent_audit_id       String?

  created_at            DateTime @default(now())

  flags                 RuleCheckFlag[]

  @@index([candidate_id])
  @@index([resume_id])
  @@index([job_requisition_id])
  @@index([decision])
  @@index([created_at])
  @@index([parent_audit_id])
  @@index([trace_id])
}

model RuleCheckFlag {
  flag_id            String   @id
  audit_id           String
  audit              RuleCheckAudit @relation(fields: [audit_id], references: [audit_id], onDelete: Cascade)

  rule_id            String
  rule_name_snapshot String
  severity           String   // terminal | needs_human | flag_only
  applicable_client  String?
  applicable         Boolean
  result             String   // PASS | FAIL | NOT_APPLICABLE
  evidence           String?
  next_action        String?  // continue | block

  created_at         DateTime @default(now())

  @@index([audit_id])
  @@index([rule_id])
  @@index([result])
  @@index([severity])
}

// =====================================================================
// AgentStepEvidence — captures input/output/external-call evidence per
// step.run inside the 3 PRA agents. Used by /monitor/flows/[flowId] to
// render a complete trail: "RAAS POST /candidates → Allmeta POST
// /Candidate → Neo4j upsert {...}".
//
// Per-run there are typically 5-10 evidence rows (one per major step).
// Flow detail UI groups by run_id + flow_id and shows ordered timeline.
// =====================================================================

model AgentStepEvidence {
  id            String   @id            // ULID
  run_id        String                  // Inngest run id
  function_slug String                  // e.g. agentic-operator-main-resume-parser-agent
  flow_id       String                  // "upload:xxx" / "jr:xxx" / "evt:xxx"

  step_name     String                  // e.g. save-candidate / write-allmeta-candidate
  step_kind     String                  // guard | fetch | compute | persist | audit | subsystem | emit | allmeta_write

  external_call String?                 // "RAAS POST /api/v1/candidates" / "Allmeta POST /instances/Candidate?domain=RAAS-v1"
  input_json    String?                 // JSON.stringify of request body (truncated to 12K)
  output_json   String?                 // JSON.stringify of response (truncated to 12K)
  error_message String?                 // if step failed
  duration_ms   Int?

  // Allmeta-write specific (when step_kind = "allmeta_write")
  allmeta_label    String?              // e.g. "Candidate" / "Resume" / "Candidate_Match_Result"
  allmeta_pk_value String?              // e.g. "cand_xxx" — the PK upserted
  allmeta_neo4j    String?              // Cypher hint or upsert result summary

  created_at    DateTime @default(now())

  @@index([run_id])
  @@index([flow_id])
  @@index([function_slug])
  @@index([created_at])
}

// =====================================================================
// Schema status: 24 tables (10 P3-foundation + 12 chunk-1 + 2 recruitment).
//
// Skipped for later (advanced ML/KB; not consumed by current AO routes —
// add when their service modules get ported in chunk 2):
//   - AgentEpisodeStats, AgentPattern, AgentSpan, AgentBlackboardEntry
//
// Definitively NOT migrating per Q1 + Q2 decisions:
//   - Editor: ActionSnapshot, ActionDiff, ChangeLog, AgentTask,
//     ReviewQueueEntry, VersionBranch, EditCheckpoint, DatasetSnapshot,
//     SnapshotChangeRecord
//   - Copilot: CopilotConversation, CopilotMessage
//   - Studio/test: StudioReport, CardReport, SimulationSnapshot, test_*
// =====================================================================

// =====================================================================
// Rule Check — eval surface for matchResume rule evaluation
// =====================================================================

model RuleCheckRun {
  id                    String    @id @default(cuid())
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  status                String    @default("running") // running | done | error
  model                 String
  clientIdOverride      String?
  totalScenarios        Int       @default(0)
  passCount             Int       @default(0)
  failCount             Int       @default(0)
  totalLlmMs            Int       @default(0)
  totalPromptTokens     Int       @default(0)
  totalCompletionTokens Int       @default(0)
  capHits               Int       @default(0)
  errorMessage          String?
  results               RuleCheckScenarioResult[]

  @@index([startedAt])
}

model RuleCheckScenarioResult {
  id                String   @id @default(cuid())
  runId             String
  run               RuleCheckRun @relation(fields: [runId], references: [id])

  scenarioId        String
  scenarioName      String

  expectedDecision  String
  expectedRules     String   // JSON: Record<rule_id, status>

  actualDecision    String
  actualStats       String   // JSON: MatchResumeCheckStats
  ruleResults       String   // JSON: RuleResult[]

  matchKind         String   // pass | fail-decision | fail-rule | fail-missing-rule | fail-parse | fail-runtime
  failures          String?  // JSON: string[]

  inferenceChain    String   // JSON: InferenceChain[]
  graphContext      String   // JSON: GraphContext

  llmMs             Int
  llmModel          String
  promptTokens      Int?
  completionTokens  Int?
  finishReason      String?
  graphCalls        Int      @default(0)
  rawLlmText        String?

  ranAt             DateTime @default(now())

  @@unique([runId, scenarioId])
  @@index([runId])
}

// =====================================================================
// Inngest mirror archive (2026-05-28) — durable copy of the Inngest dev
// server's events / runs / step-traces. The polling archiver
// (scripts/inngest-archiver.ts) upserts these every ARCHIVE_INTERVAL_MS so
// monitoring survives an Inngest crash / volume wipe. Read path:
// lib/inngest-archive/reader.ts + lib/inngest-source.ts (PG-first, live
// fallback). JSON columns are TEXT (engine-agnostic; parsed by readers).
// See docs/superpowers/specs/2026-05-28-local-postgres-inngest-archive-design.md
// =====================================================================

model InngestEventArchive {
  id          String    @id              // Inngest event id (REST id)
  internalId  String?   @map("internal_id")
  name        String
  data        String                     // JSON
  ts          DateTime?
  receivedAt  DateTime? @map("received_at")
  sourceApp   String?   @map("source_app")
  archivedAt  DateTime  @default(now()) @map("archived_at")

  @@index([name, ts])
  @@index([archivedAt])
  @@map("inngest_event_archive")
}

model InngestRunArchive {
  runId           String    @id @map("run_id")
  functionSlug    String    @map("function_slug")
  functionName    String?   @map("function_name")
  appId           String?   @map("app_id")
  status          String                  // Running | Completed | Failed | Cancelled
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMs      Int?      @map("duration_ms")
  eventName       String?   @map("event_name")
  triggerEventIds String?   @map("trigger_event_ids")  // JSON string[]
  eventPayload    String?   @map("event_payload")       // JSON (triggering event payload)
  output          String?                               // JSON (run output)
  flowId          String?   @map("flow_id")
  // Whether the full step trace + IO has been fetched for this run. The
  // archiver only does the (expensive) per-step trace fetch once a run is
  // newly seen or has just reached a terminal state, to bound GraphQL load.
  traceFetched    Boolean   @default(false) @map("trace_fetched")
  archivedAt      DateTime  @default(now()) @map("archived_at")
  lastSyncedAt    DateTime  @updatedAt @map("last_synced_at")

  steps           InngestStepArchive[]

  @@index([functionSlug])
  @@index([status])
  @@index([startedAt])
  @@index([flowId])
  @@map("inngest_run_archive")
}

model InngestStepArchive {
  id          String    @id              // `${runId}:${spanId}`
  runId       String    @map("run_id")
  run         InngestRunArchive @relation(fields: [runId], references: [runId], onDelete: Cascade)
  spanId      String    @map("span_id")
  name        String
  stepOp      String?   @map("step_op")
  status      String?
  attempts    Int?
  durationMs  Int?      @map("duration_ms")
  queuedAt    DateTime? @map("queued_at")
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  input       String?                    // JSON
  output      String?                    // JSON
  error       String?                    // JSON
  archivedAt  DateTime  @default(now()) @map("archived_at")

  @@index([runId])
  @@map("inngest_step_archive")
}

// Singleton heartbeat row (id='singleton') — archiver writes its last poll
// time + counts + last error here so /monitor can show archive freshness.
model InngestArchiveCursor {
  id             String    @id @default("singleton")
  lastPollAt     DateTime? @map("last_poll_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  eventsArchived Int       @default(0) @map("events_archived")
  runsArchived   Int       @default(0) @map("runs_archived")
  stepsArchived  Int       @default(0) @map("steps_archived")
  lastError      String?   @map("last_error")
  lastErrorAt    DateTime? @map("last_error_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("inngest_archive_cursor")
}

// =====================================================================
// Domain — top-level business container (Phase 0)
// =====================================================================
// User-extensible top-level scope. Each domain holds its own agent fleet.
// `id` is the slug used by localStorage `ao:domain` + AGENT_MAP.domain.
// `raas` and `r7` are seeded with `is_system=true` and cannot be archived.
// See docs/superpowers/specs/2026-06-01-domain-foundation-design.md.
model Domain {
  id          String    @id
  name        String
  color       String
  is_system   Boolean   @default(false) @map("is_system")
  created_at  DateTime  @default(now()) @map("created_at")
  archived_at DateTime? @map("archived_at")

  @@map("domain")
}

// =====================================================================
// Run AI Summary — durable LLM-generated summary of a workflow run.
// Supports both run-summary and agent-summary uses via nullable run_id +
// function_slug. trigger_path = 'eager-on-fail' | 'lazy-on-view' |
// 'agent-tuning'. Unique on (run_id, last_activity_at) so eager + lazy
// callers can upsert idempotently.
// =====================================================================
model RunAiSummary {
  id                    String   @id @default(cuid())
  run_id                String?
  trace_id              String?
  function_slug         String?
  trigger_event         String?
  terminal_status       String?
  last_activity_at      DateTime?
  summary_text          String
  source                String
  trigger_path          String
  llm_model             String?
  llm_duration_ms       Int?
  llm_prompt_tokens     Int?
  llm_completion_tokens Int?
  system_prompt         String?
  user_prompt           String?
  llm_raw_text          String?
  prompt_context_chars  Int?
  agents_touched        Int?
  steps_total           Int?
  steps_failed          Int?
  activity_count        Int?
  errors_excerpt        String?
  parse_error           String?
  generated_at          DateTime @default(now())

  @@unique([run_id, last_activity_at])
  @@index([run_id])
  @@index([function_slug, generated_at])
  @@index([terminal_status, generated_at])
  @@index([generated_at])
  @@map("run_ai_summary")
}

// ── 消息通知中心 (Notification center) ──────────────────────────────────
// Unified "message + alert" surface. Curated DOWNSTREAM of the full log/trace
// (everything queryable lives in the audit log); only signals worth a human's
// attention are materialized here. Messages (business lifecycle / events) are
// rendered deterministically; alerts (error/critical) are deduped by dedupeKey
// and optionally enriched by the AI manager (aiSummary/aiSeverity/...), with a
// deterministic fallback. See 2026-06-01-notification-center-and-audit-completeness-design.md.
model Notification {
  id       String   @id @default(cuid())
  ts       DateTime @default(now())

  kind     String // "message" | "alert"
  severity String // message→"info"; alert→"warning"|"critical"
  category String // "system" | "agent" | "event" | "candidate" | "job"
  source   String // business source label: agent short name | "LLM 网关" | "EM" | ...
  title    String
  body     String

  // correlation / deep-link
  runId           String?
  traceId         String?
  eventInstanceId String?
  agent           String?
  anchorsJson     String? // JSON {candidate_id, job_requisition_id, upload_id, client_id}
  linkKind        String? // "run" | "trace" | "rule_check" | "event" | "none"
  linkId          String?

  // alert-only (null for plain messages)
  dedupeKey     String?
  count         Int       @default(1)
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  status        String? // "firing" | "ack" | "resolved" | "auto_handled"
  disposition   String    @default("info_only") // "needs_human" | "auto_handled" | "info_only"
  managerAction String? // mirrored from BehaviorAlert.managerActionTaken (display only)

  // AI enrichment cache (mirrors RunAiSummary pattern)
  aiSummary      String?
  aiSeverity     String?
  aiShouldNotify Boolean?
  aiSource       String? // "llm" | "fallback" | "none"
  llmModel       String?
  aiGeneratedAt  DateTime?

  // notify + read state
  shouldNotify  Boolean   @default(false)
  notifiedAt    DateTime?
  notifyChannel String? // "in_app"
  readAt        DateTime?

  @@unique([dedupeKey, status]) // one firing alert per dedupeKey; messages have null key (distinct in PG)
  @@index([ts])
  @@index([kind, ts])
  @@index([severity, ts])
  @@index([category, ts])
  @@index([status])
  @@index([runId])
  @@index([readAt])
  @@map("notification")
}

// ── 审计日志 (unified audit log) ────────────────────────────────────────
// Single queryable record of every agent activity, mirrored fire-and-forget
// from the central AgentLogger (server/agent-logger.ts) with a normalized
// (level, category) + correlation keys. Powers /api/log-events ("show
// everything for this run/agent/severity/time"). The everything-queryable substrate;
// the Notification table is the curated, surfaced subset on top.
model LogEvent {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  level       String // debug | info | notice | warn | error | critical
  category    String // error | anomaly | tool | decision | event | lifecycle | step | hitl | info
  source      String   @default("agent") // agent | system | em | manage | external
  agent       String?
  runId       String?
  traceId     String?
  eventName   String?
  message     String
  payloadJson String?
  durationMs  Int?

  @@index([ts])
  @@index([runId, ts])
  @@index([agent, ts])
  @@index([traceId, ts])
  @@index([level, ts])
  @@index([category, ts])
  @@map("log_event")
}
