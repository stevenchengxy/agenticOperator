# ═════════════════════════════════════════════════════════════════════
#  Agentic Operator — environment template
#  Copy this file to `.env.local` and fill in the values you actually use.
#  `.env.local` is gitignored — never commit real secrets.
# ═════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════
#  STEP 0 — Choose your deployment topology FIRST.
#  Most env vars below depend on this choice.
# ═════════════════════════════════════════════════════════════════════
#
#  ┌─ Topology A: Solo dev (AO on your laptop) ───────────────────────┐
#  │                                                                   │
#  │  AO + Inngest both on YOUR machine. Partner systems are remote.   │
#  │  Bridge events from partner Inngest in/out when you want to       │
#  │  exercise the real pipeline.                                       │
#  │                                                                   │
#  │  ▸ Run a local Inngest dev:                                       │
#  │      node_modules/.bin/inngest-cli dev --host 0.0.0.0             │
#  │  ▸ INNGEST_* keep localhost:8288 defaults below                   │
#  │  ▸ INNGEST_SERVE_HOST = http://localhost:3002 (same machine)      │
#  │  ▸ RAAS_INNGEST_URL = partner's remote Inngest (for the bridge)   │
#  │  ▸ Configure section §10 (RAAS bridge) if you want auto-pull      │
#  │                                                                   │
#  └───────────────────────────────────────────────────────────────────┘
#
#  ┌─ Topology B: Deploy AO inside partner infrastructure ────────────┐
#  │                                                                   │
#  │  AO becomes one of N SDK apps registered with partner's EXISTING  │
#  │  Inngest. There is ONE Inngest server for everyone — no bridging  │
#  │  needed because events already flow on a single bus.              │
#  │                                                                   │
#  │  ▸ DO NOT run a second inngest-cli — use partner's existing one    │
#  │  ▸ INNGEST_* point to partner's existing Inngest URL/keys         │
#  │  ▸ INNGEST_SERVE_HOST = where AO is reachable from Inngest's view │
#  │    (often localhost:3002 if same host, else AO's LAN hostname)    │
#  │  ▸ ⛔ Skip section §10 entirely — bridge solves a problem that    │
#  │    doesn't exist in same-Inngest mode                             │
#  │  ▸ RAAS_POSTGRES_URL / ALLMETA_BASE_URL likely reachable as       │
#  │    localhost / internal hostnames inside partner's network        │
#  │                                                                   │
#  └───────────────────────────────────────────────────────────────────┘


# ╔═══════════════════════════════════════════════════════════════════╗
# ║                       MUST CONFIGURE                              ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── 1. Persistence (AO's own data; SQLite zero-deploy) ──────────────
# AO's run log / event log / audit table — all in this single file.
# Auto-created on first `npx prisma migrate dev`. No DB server needed.
DATABASE_URL="file:./data/ao.db"


# ─── 2. Agent file-logger output ─────────────────────────────────────
# Per-agent JSON-lines log files land here as <agent>-YYYY-MM-DD.log.
# Use an absolute path so logs are stable regardless of dev-server cwd.
AO_LOG_DIR=/absolute/path/to/agenticOperator/logs


# ─── 3. Inngest event bus (where AO's agents register) ───────────────
#
#  ⚠ Topology A: keep defaults below + run inngest-cli yourself:
#       node_modules/.bin/inngest-cli dev --host 0.0.0.0
#  ⚠ Topology B: change ALL of these to point at partner's existing
#       Inngest server (URL + the keys partner configured there).
#       Do NOT start a second inngest-cli; just register AO with theirs.
#
# These env vars are read by the Inngest SDK internally even though
# `grep process.env` shows 0 hits in this repo — keep them all.
INNGEST_DEV=http://localhost:8288
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=dev
INNGEST_SIGNING_KEY=dev

# INNGEST_SERVE_HOST = the URL where Inngest can call back to AO's SDK.
#  ▸ Topology A (Inngest + AO on same host): http://localhost:3002
#  ▸ Topology B (AO on a server in partner's network): use AO's
#       LAN-reachable hostname/IP from Inngest's perspective.
INNGEST_SERVE_HOST=http://localhost:3002
INNGEST_SERVE_PATH=/api/inngest


# ─── 4. LLM gateway ──────────────────────────────────────────────────
# Powers rule-check, tracing chatbot, agent reasoning.
#
# AO supports two modes (server/llm/gateway.ts pickGateway):
#   ① AI_BASE_URL + AI_API_KEY → route via internal OpenAI-compatible
#                                  proxy. Proxy routes AI_MODEL to the
#                                  actual model (Gemini / Claude / GPT).
#                                  AI_API_KEY is issued by the PROXY,
#                                  not by OpenAI, even though the "sk-…"
#                                  prefix mimics OpenAI's format.
#   ② OPENAI_API_KEY            → direct OpenAI api.openai.com/v1.
#
# Pick ONE. The example URL below is partner-specific — if you don't
# have a proxy, comment out AI_* and use OPENAI_API_KEY instead.
AI_BASE_URL=http://10.100.0.70:3010/v1
AI_API_KEY=sk-replace-with-your-proxy-key
AI_MODEL=google/gemini-3-flash-preview

# Fallback — only used if AI_BASE_URL + AI_API_KEY above are unset:
# OPENAI_API_KEY=sk-your-real-openai-key


# ╔═══════════════════════════════════════════════════════════════════╗
# ║                       RECOMMENDED                                 ║
# ║   Without these, the matching feature shows a warn banner /       ║
# ║   degrades to an empty state, but AO does NOT crash.              ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── 5. Allmeta Ontology Studio (rules + entity instances on :3500) ──
# Runs in a separate repo (~/allmetaOntology/apps/studio).
#
# - rule-check fetches its rule list from here. Unset → fallback to the
#   bundled rules.json static file, missing newer rules from Studio.
# - Chatbot + audit drawer resolve candidate / JR display names via here.
#   Unset → candidate / JR show as raw IDs.
#
#  ▸ Topology A: localhost:3500 if you run Studio on your laptop
#  ▸ Topology B: partner's internal Studio URL (often same machine
#       as AO inside partner's network → localhost:3500 still works)
ALLMETA_BASE_URL=http://localhost:3500
ALLMETA_API_KEY=replace-with-studio-token
ALLMETA_DOMAIN=RAAS-v1


# ─── 6. RoboHire (resume parser + match-resume backend) ──────────────
# Unset → resume parsing fails per-call (the rest of the pipeline can
# still demo via the Inngest dashboard's "Send event" sender).
ROBOHIRE_API_BASE_URL=https://api.robohire.io
ROBOHIRE_API_KEY=rh_replace_with_your_key
ROBOHIRE_TIMEOUT_MS=120000


# ╔═══════════════════════════════════════════════════════════════════╗
# ║                       OPTIONAL                                    ║
# ║   Only for specific deployment scenarios. Leave commented out     ║
# ║   for solo / isolated dev work.                                   ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── 7. Graph engine (Neo4j) — only if you want bolt-level writes ────
# Most features (rule-check reads, chatbot name resolution, audit list)
# work WITHOUT direct Neo4j config because they go through ALLMETA §5.
# Configure these ONLY when you want:
#   - the audit drawer's "graph engine live snapshot" panel to populate
#   - rule-check to additionally write audit nodes + match results
#   - the boot-time EventDefinition sync worker to run
#
# Option A — partner's shared Neo4j (VPN-gated or partner-internal):
# RAAS_LINKS_NEO4J_URI=neo4j://10.100.0.70:7687
# RAAS_LINKS_NEO4J_USER=neo4j
# RAAS_LINKS_NEO4J_PASSWORD=replace-with-shared-password
# RAAS_LINKS_NEO4J_DATABASE=neo4j
#
# Option B — local Neo4j (recommended for solo dev — spin up a container):
#   docker run -d --name ao-neo4j -p 7475:7474 -p 7688:7687 \
#     -e NEO4J_AUTH=neo4j/testpassword123 neo4j:5
# NEO4J_INSTANCE_URI=bolt://localhost:7688
# NEO4J_INSTANCE_USER=neo4j
# NEO4J_INSTANCE_PASSWORD=testpassword123
# NEO4J_INSTANCE_DATABASE=neo4j
# NEO4J_SYNC_ENABLED=1
# NEO4J_SYNC_INTERVAL_MS=300000


# ─── 8. RAAS partner Postgres (direct dual-write) ────────────────────
# AO writes candidate / job_posting / match_result rows directly to
# partner's Postgres (2026-05-20 architecture; replaces RAAS HTTP API).
# See docs/superpowers/specs/2026-05-20-ao-direct-dual-write-event-flow.md
#
#  ▸ Topology A: needed only when integrating real partner data flow
#  ▸ Topology B: usually needed — AO is in partner's network, may as
#       well write directly. Set to their internal Postgres URL.
# RAAS_POSTGRES_URL=postgresql://postgres:postgres@192.168.1.104:5432/raas_db

# Fallback employee_id used when event payload + cache both lack
# claimer_employee_id. Set to a real recruiter who claimed JRs in RAAS.
# RAAS_DEFAULT_EMPLOYEE_ID=replace-with-real-recruiter-id


# ─── 9. MinIO (only if reading real partner resume files) ────────────
# RESUME_DOWNLOADED events carry an object_key; resume-parser-agent
# fetches the binary from this bucket. Without it, parse fails per-call.
# Solo dev: leave commented; trigger test events with pre-parsed payloads.
# MINIO_ENDPOINT=192.168.1.104
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=replace-with-minio-access-key
# MINIO_SECRET_KEY=replace-with-minio-secret-key


# ─── 10. RAAS cross-machine Inngest bridge ──────────────────────────
#
#  ⛔ TOPOLOGY A ONLY — do NOT configure in Topology B.
#
#  In Topology B you have ONE Inngest server (partner's). All AO and
#  RAAS agents register with the same server, so events flow directly
#  without bridging. Setting these in Topology B does nothing useful
#  and may cause duplicate event delivery.
#
#  In Topology A: AO has its own local Inngest, partner's Inngest is
#  remote (10.100.0.70). The bridge pulls RESUME_DOWNLOADED inbound
#  and forwards MATCH_* outbound so the cross-machine pipeline works.
#
# Partner's Inngest URL (only the bridge reads this):
# RAAS_INNGEST_URL=http://10.100.0.70:8288

# Bridge toggles
#   RAAS_BRIDGE_ENABLED=1   pull RESUME_DOWNLOADED FROM partner INTO AO
#   RAAS_FORWARD_ENABLED=1  POST AO MATCH_* events TO partner
# RAAS_BRIDGE_ENABLED=0
# RAAS_BRIDGE_EVENTS=RESUME_DOWNLOADED
# RAAS_BRIDGE_POLL_INTERVAL_MS=5000
# RAAS_FORWARD_ENABLED=0


# ─── 11. Legacy P3 sidecars (WS / EM as separate services) ───────────
# Current architecture runs WS/EM in-process. Keep commented out
# unless you have an explicit reason to run the old sidecars.
# WS_BASE_URL=http://localhost:5175
# EM_BASE_URL=http://localhost:8000
