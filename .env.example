# ─────────────────────────────────────────────────────────────────────
#  Agentic Operator — environment template
#
#  Quick start (clone & run):
#    1. cp .env.example .env.local
#    2. Fill the 3 keys in section §1 (the only ones strictly required
#       for LLM-driven features). Everything else has a working default
#       for local dev.
#    3. npm install && npm run dev   (serves on http://localhost:3002)
#
#  Do NOT commit `.env` or `.env.local` — they're in .gitignore.
#
#  Anything marked  **REQUIRED**  must be filled in.
#  Anything marked  **OPTIONAL**  has a sensible default — leave blank
#  to fall back to it.
# ─────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════
#  §1. LLM gateway      **REQUIRED for any AI feature**
# ─────────────────────────────────────────────────────────────────────
#  AO uses ONE OpenAI-compatible gateway. Two ways to point it:
#
#  A) Internal / proxy gateway (preferred — OpenRouter, Azure, self-host,
#     LiteLLM, vLLM, ollama, etc. anything that speaks /v1/chat/completions)
#         set AI_BASE_URL + AI_API_KEY (+ optional AI_MODEL)
#
#  B) Direct OpenAI fallback
#         set OPENAI_API_KEY only  (model is fixed to gpt-4o-mini)
#
#  If neither is set, AI features throw GatewayUnavailableError and the
#  app falls back to deterministic mocks. The frontend still renders.
#
#  Read by: server/llm/gateway.ts, server/llm/jd-generator.ts,
#           server/llm/robohire-shape.ts, lib/rule-check/llm.ts
# ═════════════════════════════════════════════════════════════════════
AI_BASE_URL=
AI_API_KEY=
# Default when AI_MODEL is blank: "google/gemini-3-flash-preview".
# Override with any model your gateway exposes,
# e.g. "anthropic/claude-sonnet-4-6", "openai/gpt-5-mini", "qwen3-32b".
AI_MODEL=

# Fallback only — used iff AI_BASE_URL/AI_API_KEY are empty.
OPENAI_API_KEY=


# ═════════════════════════════════════════════════════════════════════
#  §2. Persistence      **OPTIONAL** (default = SQLite file in repo)
# ═════════════════════════════════════════════════════════════════════
# Default: single SQLite file at ./data/ao.db — works out of the box.
# For Postgres: set to "postgresql://user:pass@host:5432/db" AND change
# `datasource db { provider = "..." }` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./data/ao.db"


# ═════════════════════════════════════════════════════════════════════
#  §3. Inngest (workflow engine)      **OPTIONAL** for local dev
# ─────────────────────────────────────────────────────────────────────
#  Local dev: run `npx inngest-cli@latest dev` in another terminal and
#  leave the keys blank — the SDK auto-detects http://localhost:8288.
#
#  Cloud / shared partner gateway: fill in the keys + URL.
# ═════════════════════════════════════════════════════════════════════
INNGEST_EVENT_KEY=
# Where the AO Next.js app talks to Inngest *from server code*.
# Default in app/api/inngest-events/*.ts is http://localhost:8288.
INNGEST_LOCAL_URL=http://localhost:8288
# Shared partner gateway (RAAS联调). Leave blank for solo local dev.
INNGEST_BASE_URL=

# Browser-exposed mirror of INNGEST_LOCAL_URL (used by the Events page
# to render direct links to the Inngest dashboard).
NEXT_PUBLIC_INNGEST_BASE_URL=http://localhost:8288


# ═════════════════════════════════════════════════════════════════════
#  §4. RAAS / RoboHire integration      **REQUIRED for live recruitment flow**
# ─────────────────────────────────────────────────────────────────────
#  AO never calls api.robohire.io directly — it talks to RAAS, which
#  proxies RoboHire. There are TWO RAAS endpoints depending on what the
#  agent is doing:
#
#  (a) Public agent API     — createJD / matchResume tool calls
#       → RAAS_API_BASE_URL + AGENT_API_KEY
#  (b) Internal data API    — read requirements / candidates
#       → RAAS_INTERNAL_API_URL + RAAS_AGENT_API_KEY
#
#  Dev pairs:   http://localhost:3001  (run raas locally)
#  Prod pairs:  https://aicoe.chinasoftinc.com/raas-api
#  Keys are issued by the raas team — dev / staging / prod sets differ.
# ═════════════════════════════════════════════════════════════════════
RAAS_API_BASE_URL=http://localhost:3001
AGENT_API_KEY=

RAAS_INTERNAL_API_URL=http://localhost:3001
RAAS_AGENT_API_KEY=
# Per-request timeout for the internal API. Default 30000ms.
RAAS_INTERNAL_API_TIMEOUT_MS=30000

# Default employee_id sent on matchResume when the event payload omits it.
RAAS_DEFAULT_EMPLOYEE_ID=

# RoboHire direct-call escape hatch (used by scripts/probe-robohire.ts,
# scripts/e2e-real-pdf.ts only — production runtime goes through RAAS).
ROBOHIRE_BASE_URL=https://api.robohire.io
ROBOHIRE_API_KEY=
ROBOHIRE_TIMEOUT_MS=120000


# ═════════════════════════════════════════════════════════════════════
#  §5. RAAS↔AO Inngest bridge      **OPTIONAL** (off by default)
# ─────────────────────────────────────────────────────────────────────
#  When set, AO polls/forwards events to/from a shared partner Inngest
#  instance. Off in solo dev — turn on only when联调-ing with raas.
# ═════════════════════════════════════════════════════════════════════
RAAS_INNGEST_URL=http://10.100.0.70:8288
RAAS_BRIDGE_ENABLED=0
RAAS_BRIDGE_EVENTS=RESUME_DOWNLOADED
RAAS_BRIDGE_POLL_INTERVAL_MS=5000
RAAS_FORWARD_ENABLED=0


# ═════════════════════════════════════════════════════════════════════
#  §6. Neo4j      **OPTIONAL** (skip when off-VPN)
# ─────────────────────────────────────────────────────────────────────
#  Two Neo4j instances:
#    A) RAAS shared graph — source of truth for EventDefinition. AO syncs
#       read-only every NEO4J_SYNC_INTERVAL_MS. Set NEO4J_SYNC_ENABLED=0
#       to skip the boot-time sync when you're off-VPN.
#    B) Local instance for rule-check audit writes. Best-effort — failures
#       only warn, never block the agent.
# ═════════════════════════════════════════════════════════════════════
# A) RAAS shared (read-only, behind VPN)
RAAS_LINKS_NEO4J_URI=neo4j://10.100.0.70:7687
RAAS_LINKS_NEO4J_USER=neo4j
RAAS_LINKS_NEO4J_PASSWORD=
RAAS_LINKS_NEO4J_DATABASE=neo4j
NEO4J_SYNC_ENABLED=1
NEO4J_SYNC_INTERVAL_MS=300000

# Legacy fallback (used when RAAS_LINKS_* unset).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# B) Local instance for matchResumeAgent rule-check audit writes.
#    Writes (:RuleCheckAudit)-[:HAS_FLAG]->(:RuleCheckFlag). Falls back
#    to RAAS_LINKS_* above if these are blank.
NEO4J_INSTANCE_URI=bolt://localhost:7687
NEO4J_INSTANCE_USER=neo4j
NEO4J_INSTANCE_PASSWORD=
NEO4J_INSTANCE_DATABASE=neo4j

# Browser-exposed Neo4j Browser URL for "Open in Neo4j" links in the
# rule-check audit drawer.
NEXT_PUBLIC_NEO4J_BROWSER_URL=http://localhost:7475/browser/


# ═════════════════════════════════════════════════════════════════════
#  §7. MinIO / object storage      **OPTIONAL** (resume PDFs)
# ═════════════════════════════════════════════════════════════════════
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DEFAULT_BUCKET=recruit-resume-raw


# ═════════════════════════════════════════════════════════════════════
#  §8. Ontology codegen      **OPTIONAL**
# ─────────────────────────────────────────────────────────────────────
#  Only needed for `npm run gen:v4-snapshot` and /dev/generate-prompt's
#  "Live" mode.
# ═════════════════════════════════════════════════════════════════════
ONTOLOGY_API_BASE=http://localhost:3500
ONTOLOGY_API_TOKEN=


# ═════════════════════════════════════════════════════════════════════
#  §9. Event-manager schema enforcement      **OPTIONAL**
# ─────────────────────────────────────────────────────────────────────
#  false (default)  → events with no registered schema pass through as
#                     "unvalidated" — keeps the stream populated during
#                     integration testing.
#  true             → strict mode: reject unregistered events with
#                     EVENT_REJECTED. Use in production.
# ═════════════════════════════════════════════════════════════════════
EM_STRICT_SCHEMA=false


# ═════════════════════════════════════════════════════════════════════
#  §10. Rule-check LLM gate      **OPTIONAL** (off by default)
# ─────────────────────────────────────────────────────────────────────
#  When ON, matchResumeAgent runs an LLM pre-screen before calling RAAS
#  /match-resume (uses the §1 gateway):
#    LLM → KEEP     → forward to matchResume, emit RULE_CHECK_PASSED
#    LLM → DROP/PAUSE → skip the JD, emit RULE_CHECK_FAILED
#
#  Env is read per invocation (NOT cached at worker boot), so toggles
#  in Inngest cloud take effect immediately — no redeploy needed.
# ═════════════════════════════════════════════════════════════════════
RULE_CHECK_ENABLED=false

# Prompt source (only when RULE_CHECK_ENABLED=true):
#   poc     — POC composer (KEEP/DROP/PAUSE). Reads lib/rule-check/rules.json,
#             filters by (client × business_group), validated on 6 real scenarios.
#   yeyang  — 叶洋 v4 static snapshot from generated/v4/match-resume.action-object.ts.
#             Richer schema (terminal / step_results). Cross-validate before prod.
RULE_CHECK_PROMPT_SOURCE=poc

# Kenny §2 — partial resume projection. When on, the LLM sees only the
# resume fields each rule actually needs (saves 50-80% prompt tokens).
#   true / unset → on (default)
#   false        → off (sends full parsed resume — diagnostic only)
RULE_CHECK_PARTIAL_RESUME=true

# Kenny §3 — resume augmentation injection. On the KEEP path, splice the
# LLM's resume_augmentation markdown to the top of the resume sent to
# RoboHire /match-resume, so it sees our ontology pre-judgments.
#   true / unset → on (default)
#   false        → off (gate still runs but no annotation forwarded)
RULE_CHECK_AUGMENT_RESUME=true


# ═════════════════════════════════════════════════════════════════════
#  §11. Legacy sidecars (P1/P2 only)      **OPTIONAL**
# ─────────────────────────────────────────────────────────────────────
#  These point at the old EM/WS HTTP sidecars. P3+ folds their behavior
#  into the Next.js app. The defaults are fine if you haven't spun up
#  sidecars locally — the API routes will simply degrade.
# ═════════════════════════════════════════════════════════════════════
WS_BASE_URL=http://localhost:5175
EM_BASE_URL=http://localhost:8000


# ═════════════════════════════════════════════════════════════════════
#  §12. Misc dev knobs      **OPTIONAL**
# ═════════════════════════════════════════════════════════════════════
# Base URL the chat tools use to call back into AO's own API routes.
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Inngest registration helper (scripts/register-with-inngest.ts).
AO_LAN_IP=127.0.0.1
AO_PORT=3002
