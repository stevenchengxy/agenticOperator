# ═════════════════════════════════════════════════════════════════════
#  Agentic Operator — environment template
#  Copy this file to `.env.local` and fill in the values you actually use.
#  `.env.local` is gitignored — never commit real secrets.
#
#  Most subsystems fail-soft when their env vars are missing:
#    - LLM gateway off    → rule-check + chatbot show "未配置" banner
#    - Neo4j unreachable  → audit drawer instance panel shows error, rest works
#    - RAAS Postgres down → partner-pg writes fail per-call, log + continue
#  The frontend renders fully without any backend env configured.
# ═════════════════════════════════════════════════════════════════════


# ─── 1. Persistence ──────────────────────────────────────────────────
# SQLite single file (default). Auto-created on first `npx prisma migrate`.
# Prod alternative: postgres://... + flip prisma datasource in prisma/schema.prisma.
DATABASE_URL="file:./data/ao.db"


# ─── 2. Agent file-logger output ─────────────────────────────────────
# Per-agent JSON-lines log files land here as <agent>-YYYY-MM-DD.log.
# Captures every Postgres + Neo4j read/write, handler start/done, event emits.
# Use an absolute path so logs are stable across dev-server cwd changes.
AO_LOG_DIR=/absolute/path/to/agenticOperator/logs


# ─── 3. Inngest dev server (native inngest-cli on host) ──────────────
#   Start:  node_modules/.bin/inngest-cli dev --host 0.0.0.0
#   The Inngest SDK reads these env vars directly — keep them all even if
#   `grep process.env` shows 0 hits in this repo.
INNGEST_DEV=http://localhost:8288
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=dev
INNGEST_SIGNING_KEY=dev
INNGEST_SERVE_HOST=http://localhost:3002
INNGEST_SERVE_PATH=/api/inngest


# ─── 4. LLM gateway ──────────────────────────────────────────────────
# Powers: rule-check, tracing chatbot, agent reasoning.
#
# Code (server/llm/gateway.ts pickGateway) tries two modes in order:
#   ① AI_BASE_URL + AI_API_KEY  → route via internal OpenAI-compatible proxy
#                                  (e.g. new-api on partner's 10.100.0.70:3010).
#                                  Proxy then routes AI_MODEL to Gemini/Claude/GPT.
#                                  AI_API_KEY is issued by the PROXY (not OpenAI),
#                                  even though its "sk-..." format mimics OpenAI's.
#   ② OPENAI_API_KEY            → fallback, direct OpenAI api.openai.com/v1 + gpt-4o-mini.
#
# Pick ONE mode. If you have a proxy gateway, use ①. If you want direct OpenAI,
# comment out the AI_* trio below and uncomment OPENAI_API_KEY.
AI_BASE_URL=http://10.100.0.70:3010/v1
AI_API_KEY=sk-replace-with-your-proxy-key
AI_MODEL=google/gemini-3-flash-preview

# Fallback — only used if AI_BASE_URL + AI_API_KEY above are unset:
# OPENAI_API_KEY=sk-your-real-openai-key


# ─── 5. RoboHire (resume parser + match-resume API) ──────────────────
ROBOHIRE_API_BASE_URL=https://api.robohire.io
ROBOHIRE_API_KEY=rh_replace_with_your_key
ROBOHIRE_TIMEOUT_MS=120000


# ─── 6. RAAS partner integration ─────────────────────────────────────

# 6a. Direct Postgres dual-write (2026-05-20 architecture; replaces RAAS HTTP API).
#     See docs/superpowers/specs/2026-05-20-ao-direct-dual-write-event-flow.md
RAAS_POSTGRES_URL=postgresql://postgres:postgres@192.168.1.104:5432/raas_db

# 6b. Partner Inngest dev server (shared event bus)
RAAS_INNGEST_URL=http://10.100.0.70:8288

# 6c. Bridge toggles
#     RAAS_BRIDGE_ENABLED=1   pull RESUME_DOWNLOADED FROM partner Inngest INTO AO
#     RAAS_FORWARD_ENABLED=1  POST AO MATCH_* events TO partner Inngest
RAAS_BRIDGE_ENABLED=0
RAAS_BRIDGE_EVENTS=RESUME_DOWNLOADED
RAAS_BRIDGE_POLL_INTERVAL_MS=5000
RAAS_FORWARD_ENABLED=1

# 6d. Fallback employee_id when both event payload and local cache miss
#     claimer_employee_id. Set to a real recruiter who claimed JRs in RAAS.
RAAS_DEFAULT_EMPLOYEE_ID=0000199059


# ─── 7. Graph engine (Neo4j) — two instances ─────────────────────────

# 7a. RAAS-shared (read-only EventDefinition source of truth; VPN-gated).
RAAS_LINKS_NEO4J_URI=neo4j://10.100.0.70:7687
RAAS_LINKS_NEO4J_USER=neo4j
RAAS_LINKS_NEO4J_PASSWORD=replace-with-shared-graph-engine-password
RAAS_LINKS_NEO4J_DATABASE=neo4j

# 7b. AO-local Neo4j instance (preferred for AO writes).
#     Browser http://localhost:7475   ·   Bolt 7688
NEO4J_INSTANCE_URI=bolt://localhost:7688
NEO4J_INSTANCE_USER=neo4j
NEO4J_INSTANCE_PASSWORD=replace-with-local-graph-engine-password
NEO4J_INSTANCE_DATABASE=neo4j

# 7c. Boot-time Neo4j sync worker (degrades gracefully off-VPN — never blocks boot)
NEO4J_SYNC_ENABLED=1
NEO4J_SYNC_INTERVAL_MS=300000


# ─── 8. Allmeta Ontology API (Studio app on :3500) ───────────────────
# Rule-check reads rules via this HTTP layer (not direct Neo4j).
# Token must match ~/allmetaOntology/apps/studio/.env.local.
ONTOLOGY_API_BASE=http://localhost:3500
ONTOLOGY_API_TOKEN=replace-with-studio-token
ONTOLOGY_API_DOMAIN=RAAS-v1

# Same Studio, separate naming convention for the instance reader
# (used by /api/allmeta/instance and the audit drawer live snapshot panel).
ALLMETA_BASE_URL=http://localhost:3500
ALLMETA_API_KEY=replace-with-studio-token
ALLMETA_DOMAIN=RAAS-v1


# ─── 9. MinIO (shared S3-compatible object store) ────────────────────
# Partner Nextcloud webhook uploads resume files here.
MINIO_ENDPOINT=192.168.1.104
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key


# ─── 10. P3 sidecars (still up while migration in progress) ──────────
WS_BASE_URL=http://localhost:5175
EM_BASE_URL=http://localhost:8000
