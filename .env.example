# ═════════════════════════════════════════════════════════════════════
#  Agentic Operator — environment template
#  Copy this file to `.env.local` and fill in the values you actually use.
#  `.env.local` is gitignored — never commit real secrets.
# ═════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════
#  Architecture in one diagram
# ═════════════════════════════════════════════════════════════════════
#
#                ┌──────────────────────────────────────┐
#                │  Shared Inngest (Docker container,   │
#                │  one URL for everyone)               │
#                │                                       │
#                └──────────────────────────────────────┘
#                  ▲                                  ▲
#                  │ register / send events          │ register / send events
#                  │                                  │
#         ┌──────────────────┐             ┌──────────────────┐
#         │ AO Next (this    │             │ RAAS services    │
#         │ repo)            │             │ (partner repo)   │
#         │ /api/inngest     │             │ /api/inngest     │
#         └──────────────────┘             └──────────────────┘
#                  │
#                  │ HTTP (no direct Neo4j needed)
#                  ▼
#         ┌──────────────────┐             ┌──────────────────┐
#         │ Allmeta Studio   │ ──bolt──→  │ Neo4j            │
#         │ (HTTP API:3500)  │             │                  │
#         └──────────────────┘             └──────────────────┘
#
#  Key principles:
#    1. ONE Inngest for everyone — no bridge, no per-app Inngest.
#    2. AO talks to Neo4j ONLY through Allmeta — no direct bolt://
#       credentials needed in AO's env.
#    3. Other partner services (Postgres, MinIO, RoboHire) are direct
#       integrations — set their URL + key if you use them.
# ═════════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════╗
# ║                       MUST CONFIGURE                              ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── 1. Persistence — AO's own SQLite (zero deploy) ──────────────────
# Stores all AO operational state (run logs, event logs, audit tables).
# Auto-created on first `npx prisma migrate dev`. No DB server needed.
DATABASE_URL="file:./data/ao.db"


# ─── 2. Agent file-logger output ─────────────────────────────────────
# Per-agent JSON-lines log files land here as <agent>-YYYY-MM-DD.log.
# Defaults to <repo-root>/logs and auto-creates the dir on first write,
# so this is OPTIONAL — only override if you want logs on another disk.
# AO_LOG_DIR=/var/log/agentic-operator


# ─── 3. Shared Inngest (one URL for everyone) ────────────────────────
# Partner ops a dockerized Inngest. AO + RAAS both register with it,
# both publish events to it. No bridge / no local inngest-cli needed.
#
# Three values from whoever operates the shared Inngest:
#   - the URL (LAN-reachable IP : port)
#   - the event key + signing key (often "dev" in dev mode)
#
# INNGEST_BASE_URL is the canonical name read by AO's monitoring UI, event
# stream, and run-trace routes. INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY are
# read directly by the Inngest SDK at module load.
#
# (Legacy aliases INNGEST_DEV / INNGEST_LOCAL_URL / INNGEST_ADMIN_URL still
# work as fallbacks if older .env.local files set them.)
INNGEST_BASE_URL=http://<shared-inngest-host>:8288
INNGEST_EVENT_KEY=dev
INNGEST_SIGNING_KEY=dev

# Where the shared Inngest can CALL BACK to this AO instance's SDK.
# Use the URL by which Inngest (running in Docker on its host) can
# reach THIS machine's :3002 port. Same LAN → use this machine's IP.
# Same host as Inngest → http://localhost:3002 works.
INNGEST_SERVE_HOST=http://<this-machine-ip>:3002

# Route path AO mounts the serve adapter at. Don't change unless you
# renamed app/api/inngest/route.ts.
INNGEST_SERVE_PATH=/api/inngest


# ─── 4. LLM gateway ──────────────────────────────────────────────────
# Powers rule-check, tracing chatbot, agent reasoning.
#
# AO's pickGateway (server/llm/gateway.ts) tries two modes in order:
#   ① AI_BASE_URL + AI_API_KEY → route via an OpenAI-compatible proxy
#                                  (e.g. new-api). Proxy routes AI_MODEL
#                                  to the actual backend (Gemini / Claude
#                                  / GPT). AI_API_KEY is issued BY THE
#                                  PROXY, not by OpenAI, even though its
#                                  "sk-…" prefix mimics OpenAI's format.
#   ② OPENAI_API_KEY            → direct OpenAI api.openai.com/v1 with
#                                  fixed model gpt-4o-mini.
#
# Pick ONE. If you don't have a proxy, comment out the AI_* trio and
# uncomment OPENAI_API_KEY instead.
AI_BASE_URL=http://10.100.0.70:3010/v1
AI_API_KEY=sk-replace-with-your-proxy-key
AI_MODEL=google/gemini-3-flash-preview

# ── Fallback — only used if AI_* above are unset ──
# OPENAI_API_KEY=sk-your-real-openai-key


# ─── 5. Allmeta Ontology Studio (THE only Neo4j access path) ─────────
# Studio (separate repo: ~/allmetaOntology/apps/studio) owns the Neo4j
# connection internally. AO calls Studio over HTTP — Studio reads/writes
# Neo4j on AO's behalf.
#
# Used by:
#   - rule-check    — fetches rules (unset → bundled rules.json fallback)
#   - chatbot       — resolves candidate / JR / client display names
#                       (unset → entities show as raw IDs)
#   - audit drawer  — live snapshot of Candidate / Resume nodes
#   - allmeta-writers — Candidate / Resume / JD / Match Result writes
#
# ALLMETA_API_KEY must match Studio's own .env (Studio issues the token).
ALLMETA_BASE_URL=http://localhost:3500
ALLMETA_API_KEY=replace-with-studio-token
ALLMETA_DOMAIN=RAAS-v1


# ─── 6. RoboHire (resume parser + match-resume backend) ──────────────
# Production resume parser. AO calls /parse-resume and /match-resume.
# Without it, resume parsing fails per-call (rest of pipeline can still
# be demoed via Inngest dashboard with pre-parsed JSON payloads).
ROBOHIRE_API_BASE_URL=https://api.robohire.io
ROBOHIRE_API_KEY=rh_replace_with_your_key
ROBOHIRE_TIMEOUT_MS=120000

# ── Rule-check debug flag (optional) ──
# Set to "true" to force every audit to PASS without calling the LLM.
# Useful when iterating on the downstream pipeline without spending
# tokens on rule evaluation. Default: unset (= run LLM normally).
# RULE_CHECK_BYPASS=false


# ─── 7. RAAS partner Postgres (direct dual-write) ────────────────────
# AO writes candidate / job_posting / candidate_match_result rows
# directly to partner's Postgres (2026-05-20 architecture; replaces
# the legacy RAAS HTTP API write path). Without this, every "save
# candidate" / "record match result" call fails — the pipeline can
# emit events but no business data lands on partner's side.
# See docs/superpowers/specs/2026-05-20-ao-direct-dual-write-event-flow.md
RAAS_POSTGRES_URL=postgresql://postgres:postgres@<partner-host>:5432/raas_db

# Fallback employee_id used by matchResume when neither the event
# payload NOR the local cache provides claimer_employee_id. Set to a
# real recruiter who has claimed requirements in RAAS.
RAAS_DEFAULT_EMPLOYEE_ID=replace-with-real-recruiter-id


# ─── 8. MinIO (resume binary fetch) ──────────────────────────────────
# Partner Nextcloud webhook uploads resume files into this S3-compatible
# bucket. resume-parser-agent fetches the binary by object_key from
# RESUME_DOWNLOADED.payload. Without it, every RESUME_DOWNLOADED event
# stalls at the parser — no candidate downstream.
MINIO_ENDPOINT=<minio-host>
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key


# ═════════════════════════════════════════════════════════════════════
#  RARELY NEEDED — exceptional cases only
# ═════════════════════════════════════════════════════════════════════

# ─── 9. Direct Neo4j (bolt://) — almost never needed ────────────────
# §5 Allmeta already handles 99% of AO's Neo4j needs. Configure §9 ONLY
# for one niche rule-check feature: writing audit graph nodes directly
# via bolt:// for graph navigation. The Prisma `RuleCheckAudit` table
# (always written) drives the audit list + drawer UI without §9.
#
# If you actually need it, pick ONE of these — partner's shared Neo4j
# (via VPN) OR a local Neo4j container.
# NEO4J_INSTANCE_URI=bolt://localhost:7688
# NEO4J_INSTANCE_USER=neo4j
# NEO4J_INSTANCE_PASSWORD=replace-with-neo4j-password
# NEO4J_INSTANCE_DATABASE=neo4j


# ─── 10. Legacy WS / EM sidecars ────────────────────────────────────
# The current architecture runs WS/EM in-process inside the Next app.
# Keep commented out unless you have an explicit reason to run the old
# sidecar processes from the P3 migration era.
# WS_BASE_URL=http://localhost:5175
# EM_BASE_URL=http://localhost:8000
