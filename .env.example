# ═════════════════════════════════════════════════════════════════════
#  Agentic Operator — environment template
# ─────────────────────────────────────────────────────────────────────
#  Usage: 复制本文件为 .env.local 并填入真实值。
#  .env.local 在 .gitignore 里 — 严禁提交真实凭证。
#
#  每个变量的注释包含:
#    WHAT  — 是什么
#    POWERS— 启用什么功能(没配会怎么样)
#    READ  — 代码哪些文件读
#    NOTE  — 容易踩的坑
# ═════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════
#  架构总图
# ═════════════════════════════════════════════════════════════════════
#
#                ┌──────────────────────────────────────┐
#                │  Shared Inngest                       │
#                │  (Docker 或 native inngest-cli)       │
#                │  ★ AO + RAAS 都注册到同一个实例       │
#                └──────────────────────────────────────┘
#                  ▲                                  ▲
#                  │ ① POST event                    │ ② call back to run fn
#                  │   ─────────────────►            │   ◄─────────────
#                  │   INNGEST_BASE_URL              │   INNGEST_SERVE_ORIGIN
#                  │                                  │
#         ┌──────────────────┐             ┌──────────────────┐
#         │ AO Next (本 repo)│             │ RAAS partner     │
#         │ /api/inngest     │             │ /api/inngest     │
#         │ port: 3002       │             │                  │
#         └──────────────────┘             └──────────────────┘
#                  │
#       ┌──────────┼──────────┬─────────────┬──────────────┐
#       ▼          ▼          ▼             ▼              ▼
#   ┌──────┐  ┌─────────┐  ┌──────┐   ┌──────────┐   ┌──────────┐
#   │SQLite│  │ Allmeta │  │MinIO │   │Partner PG│   │ RoboHire │
#   │ao.db │  │ HTTP API│  │S3 桶 │   │ candidate│   │ /parse + │
#   │(本地)│  │ :3500   │  │简历  │   │ match_r..│   │  /match  │
#   └──────┘  └────┬────┘  └──────┘   └──────────┘   └──────────┘
#                  │ bolt://
#                  ▼
#              ┌──────────┐
#              │  Neo4j   │  ← AO 不直接连(99% 场景)
#              └──────────┘
#
#  三条核心约定:
#    1. ONE shared Inngest — AO + RAAS 共用一个实例,没有 bridge / 没有
#       per-app Inngest。AO 发事件用 ① 的 URL,接 Inngest 回调用 ②。
#    2. Neo4j 只走 Allmeta HTTP — AO 不存 bolt:// 凭证(§9 是小众例外)。
#       agent 写实体节点 全部 通过 lib/allmeta-writers/* → Allmeta → Neo4j。
#    3. 业务数据双写 — candidate / job_posting / candidate_match_result
#       直接写 partner Postgres(§7);同时通过 Allmeta 同步进 Neo4j。
# ═════════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════╗
# ║                  MUST CONFIGURE  (§1–§8)                          ║
# ║                  缺了 partner 部署一定跑不通                       ║
# ╚═══════════════════════════════════════════════════════════════════╝


# ─── §1. AO 本地持久化 (本地 Postgres) ─────────────────────────────────
#
# WHAT   AO 自己的数据库连接串。2026-05-28 从 SQLite 迁到本地 Postgres
#        (持久、并发安全)。prisma + @prisma/adapter-pg。
# POWERS — Run / Step / AgentActivity 全套运营日志
#        — RuleCheckAudit + RuleCheckFlag(规则审计表,/rule-check 页核心数据)
#        — AgentConfig(agent 暂停/恢复 状态)+ AgentConfigHistory
#        — BehaviorAlert + HumanTask(告警 + 人工任务)
#        — EventInstance + EventDefinition(事件元数据)
#        — Inngest 镜像表 inngest_{event,run,step}_archive + cursor(§1b)
#        — 共 36 张表,见 prisma/schema.prisma
# READ   server/db/index.ts (按 scheme 选 adapter), prisma.config.ts
# NOTE   ① ★ 端口 5433(不是 5432):本机 5432 被 raas-postgres-dev 占用。
#        ② 供给:`npm run pg:up`(docker-compose.postgres.yml,named volume
#          ao-pgdata,重建容器不丢数据)。`npm run dev` 会自动起 + db push。
#        ③ 旧 SQLite 数据迁移:`npm run db:migrate-from-sqlite`(幂等)。
#        ④ 没配 → 默认走 postgresql://ao:ao_local_pw@localhost:5433/ao。
#        ⑤ 留 file:./data/ao.db 仍可跑 SQLite(adapter 按 scheme 自动切),
#          仅用于读旧库做迁移。
DATABASE_URL="postgresql://ao:ao_local_pw@localhost:5433/ao"

# docker-compose.postgres.yml 用这些(默认值,本地够用):
AO_POSTGRES_USER=ao
AO_POSTGRES_PASSWORD=ao_local_pw
AO_POSTGRES_DB=ao
AO_POSTGRES_PORT=5433


# ─── §1b. Inngest 归档器 — Inngest 数据的持久镜像 ──────────────────────
#
# WHAT   独立长驻轮询进程(scripts/inngest-archiver.ts,`npm run archive`)。
#        定时从 Inngest dev server 拉 events / runs / step-traces,幂等
#        upsert 进 §1 Postgres 的 inngest_*_archive 表。Inngest middleware
#        会在 run start/finish 时 write-through 直接落库;轮询器是补偿网。
# WHY    监控页本来实时读 Inngest;Inngest 崩溃/清 volume 就丢历史。归档器
#        持续镜像 → 一旦落库即使 Inngest 宕机也不丢,监控可回退读 Postgres。
# READ   lib/inngest-archive/{writer,reader,mappers}.ts, lib/inngest-source.ts
# NOTE   ① `npm run dev` 会后台自启(去重,见 dev-bootstrap.mjs);也可单独
#          `npm run archive` 跑。设 ARCHIVE_ENABLED=0 关闭。
#        ② 复用 §3 的 INNGEST_BASE_URL + MONITORED_APP_PREFIX。
ARCHIVE_ENABLED=1
ARCHIVE_INTERVAL_MS=30000
ARCHIVE_WINDOW_HOURS=168
ARCHIVE_EVENT_LIMIT=1000
ARCHIVE_RUN_LIMIT=1000
ARCHIVE_TRACE_CONCURRENCY=4
# 监控读数据源: auto(Postgres 优先, 缺则回退 live) | postgres | live
MONITOR_READ_SOURCE=auto


# ─── §2. Agent 文件日志输出目录(可选) ────────────────────────────────
#
# WHAT   每个 agent 调用产生的 JSON-lines 日志落盘目录。
#        命名: <agent-name>-YYYY-MM-DD.log
# POWERS — 调试 agent 内部 step 序列、API call 时延、LLM token 用量
#        — Fleet 详情页 + Run drawer 显示的"agent file log"列表
# READ   lib/agent-logger.ts:18
# NOTE   默认 <repo-root>/logs,首次写入时自动 mkdir → 一般不用配。
#        只有想集中日志 / 换硬盘的情况才覆盖。
# AO_LOG_DIR=/var/log/agentic-operator


# ─── §2.1 终端日志开关(可选) ─────────────────────────────────────────
#
# WHAT   是否把日志 echo 到终端(stdout)。**只管终端 echo**,不影响落盘
#        日志(logs/*.log 始终照常写)。
# WHY    真实部署时每步 agent / 每次外部 API 都往 stdout 刷 request+response
#        JSON,刷屏且拖慢运行 → 生产默认关掉。
# VALUES 0 | false | off → 关; 1 | true | on → 开;
#        不配 → 开发(NODE_ENV≠production)开,生产(NODE_ENV=production)关。
# NOTE   console.error / console.warn 不受此开关控制 → 生产仍能看到报错/告警。
#        生产里临时排查时设 AO_TERMINAL_LOG=1 即可重新打开。
# READ   lib/terminal-log.ts
# AO_TERMINAL_LOG=0


# ─── §3. Shared Inngest — 事件引擎(必填,6 个相关变量)──────────────
#
# Inngest 是 AO 的事件分发 + 函数调度核心。两个方向通信:
#
#   ① AO ──POST event──▶  Inngest        (AO 发事件用)
#   ② AO ◀──call fn──── Inngest        (Inngest 回调 AO 跑函数用)
#
# 因此需要两个独立的 URL:一个告诉 AO "Inngest 在哪",一个告诉 Inngest
# "AO 在哪"。两者都必须在 .env.local 显式配置 — Docker / 跨机部署时
# 默认的 localhost 兜底完全不对。

# ── ①.AO 发事件给 Inngest 用的 URL ────────────────────────────────────
#
# WHAT   Shared Inngest 服务端的 HTTP 地址(LAN 可达的 host:port)。
# POWERS — agent 发送 RESUME_DOWNLOADED / JD_GENERATED / MATCH_* 等事件
#        — /events 页 firehose tab 拉 Inngest /v1/events 实时流
#        — /monitor 页 Inngest 子系统健康检查
#        — /api/inngest-admin/{functions,runs,dlq} 管理面板拉数据
#        — /api/runs/[id]/trace 跨系统 trace 聚合
# READ   lib/inngest-url.ts:18  (所有上述路径都走这个 resolver)
#        Legacy 别名: INNGEST_DEV / INNGEST_LOCAL_URL / INNGEST_ADMIN_URL
#        仍作为 fallback 支持,但请用 INNGEST_BASE_URL 这个 canonical 名。
# NOTE   ① 必须是 Inngest 那台机的实际 LAN IP / hostname,不是 localhost
#          (除非 AO 跟 Inngest 跑在同一台机的同一个 host)。
#        ② 改完必须**完全重启** Next 进程(SIGTERM + 重启,不是 reload)。
INNGEST_BASE_URL=http://<shared-inngest-host>:8288

# ── Inngest 鉴权 key (dev 模式都用 "dev",生产换真 key) ─────────────────
#
# WHAT   Inngest SDK 上行事件签名 + 校验 SDK 注册的密钥。
# POWERS — Inngest SDK new Inngest({ eventKey }) 在 server/inngest/client.ts:504
#        — SDK 内部 introspect / register / receive call 用
# READ   inngest npm 包内部自动读 process.env.INNGEST_EVENT_KEY /
#        INNGEST_SIGNING_KEY,代码不显式 grep。
# NOTE   dev 模式 Inngest 默认接受 "dev",生产环境必须改成 Inngest cloud /
#        生产 Inngest 发的真 key。NODE_ENV=production 时 AO 会拒绝 "dev"。
#        两个值通常跟 Inngest 部署方一致。
INNGEST_EVENT_KEY=dev
INNGEST_SIGNING_KEY=dev

# ── ②.Inngest 回调 AO 用的 URL(★ 容易漏配 ★) ───────────────────────
#
# WHAT   告诉 Inngest "AO 在哪个 URL 接收回调"。Inngest 注册函数时
#        会把这个 URL 写进它的 registry,事件命中 trigger 时主动 POST 到
#        这里来执行函数。
# POWERS — 所有 agent 函数能被 Inngest 真的调起来(没这个 = 函数永远不跑)
#        — toggle pause/resume 后的 SDK 重新注册(/api/inngest PUT)
# READ   Inngest SDK 自动读 (server/inngest/client.ts 实例化时);
#        app/api/inngest-admin/functions/[slug]/toggle/route.ts:46
# NOTE   ① 关键场景:
#          - AO 跟 Inngest 同机 → http://localhost:3002 ✓
#          - AO 跟 Inngest 不同机 → 必须填 AO 这台机的 LAN IP
#          - AO 跑 Docker 容器内 → 必须填宿主机/容器外可达地址
#        ② 怎么判断配错没?
#          打开 http://<inngest-host>:8288/apps,看 agentic-operator-main
#          这个 app 有没有出现 + functions 列表全不全。触发事件后
#          Run 能起来 = 这个 URL 配对了;Run 卡 queued / connect refused
#          = 配错了。
#        ③ Legacy 别名 INNGEST_SERVE_HOST 仍兼容,但新环境请使用 ORIGIN。
INNGEST_SERVE_ORIGIN=http://<this-machine-ip>:3002

# ── 注册脚本回连 AO 用的地址(可选覆盖)─────────────────────────────
#
# WHAT   `npm run register` 自己 PUT 一次 serve endpoint 时用的 URL。
# WHY    共享 Inngest 模式下 INNGEST_SERVE_ORIGIN 常写成
#        http://host.docker.internal:3002 —— 那是给容器用的别名,脚本
#        跑在宿主机上,需要一个宿主机自己能解析的地址。
# 默认   INNGEST_SERVE_ORIGIN 的 host 是 host.docker.internal 时自动回退
#        到 http://127.0.0.1:<同端口>;其它情况直接用 ORIGIN。只有默认
#        推导不对(例如 AO 在另一台机器)时才需要显式设置。
# READ   scripts/register-with-inngest.ts
# INNGEST_SERVE_CONNECT_ORIGIN=http://127.0.0.1:3002

# ── AO 挂载 serve adapter 的路径 ────────────────────────────────────
#
# WHAT   AO 暴露给 Inngest 调用的 HTTP 路径。
# POWERS Inngest SDK 注册时拼成 ${INNGEST_SERVE_ORIGIN}${INNGEST_SERVE_PATH}
#        = http://<host>:3002/api/inngest 作为函数 entry point。
# READ   inngest/next serve() helper
# NOTE   除非你改了 app/api/inngest/route.ts 的位置,否则保持默认。
INNGEST_SERVE_PATH=/api/inngest

# ── 浏览器端 Inngest URL(NEXT_PUBLIC_*)─────────────────────────────
#
# WHAT   浏览器 client 端构造 Inngest dashboard 链接用的 URL。
# POWERS — /monitor 页 "↗ 打开 Inngest dashboard" 按钮
#        — /events 页 "在 Inngest 查看" 链接
#        — 事件抽屉里跳 Inngest stream 的外链
# READ   lib/inngest-url-client.ts:14
#        components/monitor/ActionBar.tsx:99
#        components/events/InstanceTrailContent.tsx:277
# NOTE   Next.js 只把 NEXT_PUBLIC_* 前缀的变量暴露给浏览器 bundle,
#        所以 INNGEST_BASE_URL(服务端用)不能被浏览器代码直接读。
#        必须额外配这个,**并且值等于 INNGEST_BASE_URL**。
#        ★ NEXT_PUBLIC_* 是 build-time 嵌入 bundle 的,改了之后
#          必须重新 `npm run build`,光重启 npm run start 不生效。
NEXT_PUBLIC_INNGEST_URL=http://<shared-inngest-host>:8288


# ─── §4. LLM 网关(必填,二选一)──────────────────────────────────────
#
# WHAT   AI agent reasoning + rule-check 评估 + tracing chatbot 用的 LLM。
# POWERS — rule-check-agent: 规则审计的 LLM 评估(每条规则一次 LLM call)
#        — match-resume-agent: 候选人与岗位的匹配评分
#        — create-jd-agent: JD 自动生成
#        — chat / trace 页的 streaming chatbot
# READ   server/llm/gateway.ts:31 (pickGateway)
#
# 两种模式,代码自动二选一:
#   模式 ① AI_BASE_URL + AI_API_KEY + AI_MODEL → 走 OpenAI-compatible 代理
#          (内部 new-api / one-api / litellm 等)。代理路由 AI_MODEL 到真实
#          backend (Gemini / Claude / GPT)。这种模式 AI_API_KEY 是 **代理**
#          颁发的,不是 OpenAI 颁发的(尽管 "sk-..." 前缀长得像)。
#   模式 ② OPENAI_API_KEY → 直连 api.openai.com/v1,固定 gpt-4o-mini。
#
# 配 ① 优先,代码先匹配 AI_BASE_URL;两组都没配 → throw GatewayUnavailableError。
AI_BASE_URL=http://10.100.0.70:3010/v1
AI_API_KEY=sk-replace-with-your-proxy-key
AI_MODEL=google/gemini-3-flash-preview

# ── Fallback — 只有 AI_* 都不填时才用 ───
# OPENAI_API_KEY=sk-your-real-openai-key


# ─── §5. Allmeta Ontology Studio — Neo4j 唯一入口 ────────────────────
#
# WHAT   Allmeta Studio (跑在端口 :3500 的独立 Next 应用) 是 AO 访问 Neo4j
#        的唯一 HTTP 网关。AO 调 Allmeta 的 REST API,Studio 内部用 bolt://
#        读写 Neo4j → AO 不需要管 Neo4j 凭证(99% 场景)。
# POWERS — agent 写实体(lib/allmeta-writers/*)→ 全部 4 个 agent 写
#          Candidate / Resume / Job_Requisition / Job_Posting / Application /
#          Candidate_Match_Result 走这条路径
#        — rule-check 取规则: GET /api/v1/ontology/actions/{action}/rules
#          (没配 → 回退用 lib/rule-check/rules.json bundled 老快照)
#        — chatbot 实体名解析(候选人 / JR / 客户名字 → 用 ID 拼显示名)
#          (没配 → UI 显示成裸 ID,但功能正常)
#        — audit drawer 实体节点 panel(显示候选人/简历节点快照)
# READ   lib/allmeta-client.ts:8 (writers + chatbot 走这个)
#        lib/rule-check/instance-client.ts:13 (rule-check graph context)
#        lib/rule-check/api-rule-fetcher.ts (规则定义来源)
# NOTE   ① ALLMETA_API_KEY 跟 Allmeta Studio 的 .env 里那个 token 必须一致
#          (Studio 那边颁发,这边消费)。
#        ② ALLMETA_DOMAIN 决定 ontology 域。partner 用 RAAS-v1。
#          如果改了这个,instance-client.ts 也会同步用新值。
#        ③ 没配 ALLMETA_BASE_URL → agent 写 Neo4j 抛 "ALLMETA_BASE_URL is
#          not configured" 清晰错误(改前是静默连 localhost:3500 失败)。
ALLMETA_BASE_URL=http://localhost:3500
ALLMETA_API_KEY=replace-with-studio-token
ALLMETA_DOMAIN=RAAS-v1


# ─── §6. RoboHire — 简历解析 + 匹配服务 ──────────────────────────────
#
# WHAT   RoboHire 是外部简历 AI 服务,提供两个 endpoint:
#          POST /api/v1/parse-resume  — 接收 PDF binary,返回结构化候选人 JSON
#          POST /api/v1/match-resume  — 接收 resume + JD,返回匹配分 + 评估
# POWERS — resume-parser-agent: 整条简历解析链路(MinIO 取 PDF → RoboHire
#          parse → 结构化 candidate JSON → 写 partner Postgres + Allmeta)
#        — match-resume-agent: 候选人 ↔ JD 匹配评分
# READ   lib/robohire-client.ts:69 (主路径)
#        lib/robohire.ts:8, server/llm/robohire.ts:22 (legacy aliases,
#          均使用 RAAS_API_BASE_URL 旧名 — 历史包袱,会逐步收敛)
# NOTE   ① 没配 → RESUME_DOWNLOADED 卡在 parser-agent,下游全停。
#        ② 公网 https,partner 不在 VPN 内也能直连。
#        ③ TIMEOUT 默认 120 秒 — parse 3-8 秒、match 5-15 秒,但偶尔抖动
#          会到几十秒,所以留宽。
ROBOHIRE_API_BASE_URL=https://api.robohire.io
ROBOHIRE_API_KEY=rh_replace_with_your_key
ROBOHIRE_TIMEOUT_MS=120000

# ── Rule-check 调试开关(可选)──
#
# WHAT   true 时所有规则审计强制 PASS,不调 LLM。
# POWERS 联调下游 pipeline 时不想烧 LLM token,直接放过 rule-check。
# READ   server/inngest/agents/rule-check-agent.ts
# NOTE   生产部署务必关掉(注释或不设)。
# RULE_CHECK_BYPASS=false


# ─── §7. RAAS partner Postgres — 业务数据双写 ────────────────────────
#
# WHAT   partner 那边的 PostgreSQL 数据库。AO 写候选人 / 岗位 / 匹配结果
#        直接落进这里,跟 Allmeta 写 Neo4j 是 "双写" 模式。
# POWERS — lib/partner-pg/ 下所有 writer
#        — candidate / job_requisition / job_posting / candidate_match_result
#          / candidate_match_result_runtime_state / resume / resume_upload_runtime
#          7 张 partner-owned 表
#        — Workflow 中 "save candidate" / "record match result" 等所有
#          业务数据落地动作
# READ   lib/partner-pg/client.ts:* (所有 partner-pg writer 共用)
# NOTE   ① schema 由 RAAS team 负责,AO 假设 7 张表已经存在(没建 →
#          agent 报 "relation does not exist")。
#        ② 连接串格式: postgresql://user:pwd@host:port/dbname
#        ③ partner 那边 7 张表的 DDL 不在 AO 这个 repo,请向 RAAS team 索取。
RAAS_POSTGRES_URL=postgresql://postgres:postgres@<partner-host>:5432/raas_db

# ── matchResume 兜底 employee_id ──
#
# WHAT   match-resume-agent 处理事件时,如果 event payload 和本地 cache
#        都没提供 claimer_employee_id (认领该需求的 recruiter),用这个值兜底。
# POWERS 防止匹配结果归属为 null,partner HR 看不到结果。
# READ   server/inngest/agents/match-resume-agent.ts
# NOTE   填一个真实存在的 recruiter ID(partner RAAS 里有"认领"过需求的人)。
#        随便填假 ID 会让所有兜底场景的匹配结果 attribute 给不存在的人。
RAAS_DEFAULT_EMPLOYEE_ID=replace-with-real-recruiter-id


# ─── §8. MinIO — 简历 binary 存储(S3-compatible)─────────────────────
#
# WHAT   partner 那边 Nextcloud webhook 上传简历 PDF 时把文件写进 MinIO 这个
#        S3 兼容对象存储。AO 通过 object_key 取 binary。
# POWERS — resume-parser-agent 从 RESUME_DOWNLOADED.payload.objectKey 取 PDF
#          → 喂给 RoboHire /parse-resume
# READ   lib/minio-client.ts (resume-parser-agent 调)
# NOTE   ① 没配 → 每个 RESUME_DOWNLOADED 事件都卡在 parser-agent,下游
#          所有 agent(matcher / rule-check)都不会被触发。
#        ② USE_SSL=true 时 endpoint 不要写 "http://" 前缀(MinIO SDK 自己拼)。
#        ③ Bucket 名不在 env 里 — agent 从事件 payload.bucket 取。
MINIO_ENDPOINT=<minio-host>
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key


# ═════════════════════════════════════════════════════════════════════
#  OPTIONAL — 调试/小众功能(默认全关)
# ═════════════════════════════════════════════════════════════════════


# ─── Demo stub agents（默认关 — 生产务必保持关）────────────────────
#
# WHAT   给 AGENT_MAP 里未接真实实现的 ~18 个 agent（ResumeCollector /
#        Publisher / ReqAnalyzer …）各注册一个"空壳"Inngest 函数:收事件 →
#        sleep → 用 Math.random 随机成功/失败 → emit 下游"假"事件。
# POWERS — 让 /fleet · /workflow · /monitor 在没有真实事件时也能演示完整链路。
# READ   server/inngest/functions.ts · server/inngest/agents/stub-factory.ts
# NOTE   ★ 生产务必保持关:开着会自己造一套假事件级联,跟真实 RAAS 事件抢
#        同名、重复触发(例如两条 RESUME_DOWNLOADED),污染监控。
#        `npm run dev:demo` 会自动设 STUB_AGENTS=1 点亮本地 demo;正常
#        `npm run dev` / 生产 `next start` 默认关,无需配置(不设 / 设成 0 都是关)。
# STUB_AGENTS=1


# ─── Unsafe dev routes（默认生产关闭）──────────────────────────────
#
# WHAT   只给隔离 staging/本地烟测使用。打开后生产环境仍可访问:
#        /api/test/*、/api/mock-raas/*、/api/em/publish。
# NOTE   正式上线务必保持关闭。需要演示时只在内网/临时 staging 机器设 1。
# AO_ENABLE_UNSAFE_DEV_ROUTES=1


# ─── 监控范围过滤 ──────────────────────────────────────────────────
#
# WHAT   /monitor 页只显示这个前缀的 Inngest functions(过滤掉 raas-backend
#        等第三方 app)。
# READ   lib/inngest-admin-client.ts:25
# NOTE   清空(MONITORED_APP_PREFIX=)= 显示所有 app。
# MONITORED_APP_PREFIX=agentic-operator-main


# ─── EventDefinition 同步(off-by-default)──────────────────────────
#
# WHAT   定时从 Neo4j 拉 EventDefinition schema 同步到本地 SQLite。
# POWERS — /events 页事件 schema 显示 + 校验
# READ   server/em/sync/event-definition-sync.ts
# NOTE   需要 §9 NEO4J_INSTANCE_* 也配齐。off-VPN 时 sync 会失败但不阻塞。
# NEO4J_SYNC_ENABLED=1
# NEO4J_SYNC_INTERVAL_MS=300000


# ─── RAAS Inngest bridge(架构遗留,新部署不需要)──────────────────
#
# 单 Inngest 架构下不需要 bridge,这俩默认关。代码保留用于过渡期。
# RAAS_BRIDGE_ENABLED=1
# RAAS_BRIDGE_POLL_INTERVAL_MS=5000
# RAAS_BRIDGE_EVENTS=RESUME_DOWNLOADED
# RAAS_FORWARD_ENABLED=1
# RAAS_INNGEST_URL=http://<other-inngest-host>:8288


# ═════════════════════════════════════════════════════════════════════
#  RARELY NEEDED — 99% 场景不用配
# ═════════════════════════════════════════════════════════════════════


# ─── §9. 直连 Neo4j (bolt://) ───────────────────────────────────────
#
# WHAT   AO 直接通过 bolt 协议连 Neo4j 的凭证。
# POWERS — rule-check audit drawer 里 "关联实体节点" 那个小 panel
#          (审计详情页打开时直接查 Neo4j 拉相关 Candidate/Resume/JR
#          节点显示)
#        — server/em/clients/neo4j.ts(EM 子系统的 EventDefinition 同步)
# NOTE   ① 99% 功能不依赖这个:agent 写实体走 §5 Allmeta,
#          RuleCheckAudit 主表走 §1 SQLite,跟这无关。
#        ② 不配 → audit drawer 右侧 "关联节点" panel 空白,其他都正常。
#        ③ 配的话 URI 用 bolt://(不是 http://)。
# NEO4J_INSTANCE_URI=bolt://localhost:7688
# NEO4J_INSTANCE_USER=neo4j
# NEO4J_INSTANCE_PASSWORD=replace-with-neo4j-password
# NEO4J_INSTANCE_DATABASE=neo4j


# ─── 浏览器端 Neo4j browser 跳转链接 ────────────────────────────────
#
# WHAT   rule-check audit drawer 里 "在 Neo4j browser 打开" 链接的 base URL。
# POWERS — components/rule-check/RuleCheckAuditDetailDrawer.tsx:1659 的外链
# READ   process.env.NEXT_PUBLIC_NEO4J_BROWSER_URL
# NOTE   ① 跟 §9 NEO4J_INSTANCE_URI 是配套使用(neo4j browser UI 默认 :7475)。
#        ② NEXT_PUBLIC_* 必须重 build 才生效。
# NEXT_PUBLIC_NEO4J_BROWSER_URL=http://localhost:7475/browser/


# ─── §10. 老 P3 sidecars (legacy)────────────────────────────────────
#
# 当前架构 WS + EM 都跑在 Next 进程内。这两个变量只在你显式想跑 P3
# 时期的独立 sidecar 进程时用,99% 部署不需要。
# WS_BASE_URL=http://localhost:5175
# EM_BASE_URL=http://localhost:8000

# ─── §11. 候选人锁定 — 公司 RMHR 简历锁定接口 (2026-06-08) ───────────────
# 见 docs/superpowers/specs/2026-06-08-candidate-lock-rmhr-alignment-design.md
#
# RMHR uploadByRecruiterEmail 的完整网关 URL(含 ?module=rmhr_internal&...&method=...)。
# 测试环境: http://gdev.chinasoftinc.com:8999/soulin/?module=rmhr_internal&httpMethod=post&method=/internal/uploadByRecruiterEmail
# RMHR_INTERNAL_HOST=
# 服务间鉴权密钥(由 RMHR/partner 提供;切勿提交进仓库)。
# RMHR_INTERNAL_API_KEY=
# 调用超时(毫秒,默认 20000)。
# RMHR_TIMEOUT_MS=20000
# resumeSourceId 兜底渠道码(partner 确认后填)。
# DEFAULT_RESUME_SOURCE_ID=02001034
#
# Feature flags(默认全关 = 与接入前行为完全一致):
#   LOCK_CHECK_ENABLED=1       上传时调 RMHR + 计算锁定决策 + 落账(dark-launch:只观察不拦)
#   CANDIDATE_LOCK_PG_WRITE=1  把锁定真相写入本地 CandidateLock 表
#   LOCK_CHECK_ENFORCE=1       真正拦截(lock-only 抑制 RESUME_PROCESSED;可恢复故障 park)
#   DEDUP_PHONE_PRIMARY=1      候选人去重改为以手机号为唯一主键(对齐 RMHR;需先回填 mobile_normalized)
# LOCK_CHECK_ENABLED=0
# CANDIDATE_LOCK_PG_WRITE=0
# LOCK_CHECK_ENFORCE=0
# DEDUP_PHONE_PRIMARY=0

# ─── §12. 企业微信告警推送 — OpenClaw 网关通道 (2026-06-10) ──────────────
# 见 docs/superpowers/specs/2026-06-10-wecom-alert-channel-design.md
#
# WHAT   告警(warning/critical)与白名单业务事件经 OpenClaw 网关推送到企业微信
#        AICOE 智能机器人。发送走 docker exec → 网关容器内 CLI,链路无 LLM。
# POWERS — server/notifications/channels.ts 的 OpenClawWecomChannel
# READ   process.env.*(发送时读取,改值需重启 dev/prod 进程)
# NOTE   ① 企微规则:接收人必须先给 AICOE 机器人发过一条消息,target 用
#          「原始大小写」的 userId/groupId(从网关日志 from.userid 取)。
#        ② 打开通道:NOTIFY_CHANNELS 加上 openclaw-wecom 且 WECOM_ALERT_TARGETS
#          非空;两者缺一通道静默。
#        ③ 同一 firing 告警行 WECOM_REPEAT_SUPPRESS_MIN 分钟内只推一次,防刷屏。
# NOTIFY_CHANNELS=in_app,openclaw-wecom
# WECOM_ALERT_TARGETS=
# WECOM_ALERT_MIN_SEVERITY=warning
# WECOM_EVENT_WHITELIST=MATCH_PASSED_NEED_INTERVIEW,INTERVIEW_INVITATION_SENT,JD_GENERATED
# WECOM_REPEAT_SUPPRESS_MIN=15
# OPENCLAW_GATEWAY_CONTAINER=openclaw-openclaw-gateway-1
# WECOM_MAX_RESENDS=3            # 同一 firing 告警首发后最多补发几次,之后静默到解除
# WECOM_SEND_RECOVERY=1          # critical 告警解除时推"已解除"(报警也报平安);0 关
# WECOM_MSG_RATE_PER_MIN=10      # message 类(业务事件白名单)全局限流,超额丢弃只影响外推
#
# ─── §12b. 通知/审计保留策略 + 监控骨干自监 (2026-06-11) ────────────────
# NOTIFICATION_RETENTION_DAYS=0   # 0=永久保留; >0 才清理已读消息与已解除/已确认告警
# MONITOR_EVAL_RETENTION_DAYS=0   # 0=永久保留; >0 才清理 MonitorEval
# LOG_EVENT_RETENTION_DAYS=0      # 统一审计日志保留;0=永久(默认,审计全量保留是显式需求)
# WATCH_DB_STALE_MS=600000        # watchdog 判定归档器/扫描器心跳过期的毫秒数(默认 10 分钟)
# AO_BASE_URL=http://localhost:3002
